package main

import "testing"

func TestYigindiChannelBasic(t *testing.T) {
	got := yigindiChannel([]int{1, 2, 3, 4, 5})
	want := 15
	if got != want {
		t.Errorf("yigindiChannel([1,2,3,4,5]):\nExpected:\n%d\n\nGot:\n%d", want, got)
	}
}

func TestYigindiChannelEmpty(t *testing.T) {
	got := yigindiChannel([]int{})
	want := 0
	if got != want {
		t.Errorf("yigindiChannel([]):\nExpected:\n%d\n\nGot:\n%d", want, got)
	}
}

func TestYigindiChannelSingle(t *testing.T) {
	got := yigindiChannel([]int{100})
	want := 100
	if got != want {
		t.Errorf("yigindiChannel([100]):\nExpected:\n%d\n\nGot:\n%d", want, got)
	}
}

func TestYigindiChannelNegative(t *testing.T) {
	got := yigindiChannel([]int{-5, 10, -3})
	want := 2
	if got != want {
		t.Errorf("yigindiChannel([-5,10,-3]):\nExpected:\n%d\n\nGot:\n%d", want, got)
	}
}
