	return fmt.Sprintf("manfiy son qabul qilinmaydi: %d", e.Qiymat)
}

// ildiz x ning kvadrat ildizini hisoblaydi, x manfiy bo'lsa xatolik qaytaradi.
func ildiz(x int) (float64, error) {
	// TODO: x < 0 bo'lsa &ManfiySonError{Qiymat: x} qaytaring, aks holda math.Sqrt
	return 0, nil
}

func main() {
	natija, err := ildiz(16)
	fmt.Println(natija, err)

	_, err = ildiz(-9)
	fmt.Println(err)
}
