package main

import (
	"reflect"
	"testing"
)

func TestBufferGaJoylashBasic(t *testing.T) {
	got := bufferGaJoylash([]int{1, 2, 3})
	want := []int{1, 2, 3}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("bufferGaJoylash([1,2,3]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}

func TestBufferGaJoylashEmpty(t *testing.T) {
	got := bufferGaJoylash([]int{})
	want := []int{}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("bufferGaJoylash([]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}

func TestBufferGaJoylashSingle(t *testing.T) {
	got := bufferGaJoylash([]int{99})
