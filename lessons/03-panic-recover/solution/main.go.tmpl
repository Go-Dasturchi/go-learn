package main

import "fmt"

// xavfsizBolish a ni b ga bo'ladi; agar bu panic qilsa (masalan b == 0),
// 0 qaytaradi, dastur qulamaydi.
func xavfsizBolish(a, b int) (natija int) {
	defer func() {
		if recover() != nil {
			natija = 0
		}
	}()
	natija = a / b
	return
}

func main() {
	fmt.Println(xavfsizBolish(10, 2))
	fmt.Println(xavfsizBolish(10, 0))
	fmt.Println("Dastur davom etyapti")
}
