	if !reflect.DeepEqual(got, want) {
		t.Errorf("juftSonlar(5):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}

func TestJuftSonlarOne(t *testing.T) {
	got := juftSonlar(1)
	want := []int{}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("juftSonlar(1):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
