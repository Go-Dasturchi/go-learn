package main

import "fmt"

// birinchiTayyor ch1 yoki ch2 dan qaysi biri birinchi qiymat yuborsa,
// o'sha qiymatni qaytaradi.
func birinchiTayyor(ch1, ch2 chan string) string {
	select {
	case v := <-ch1:
		return v
	case v := <-ch2:
		return v
	}
}

func main() {
	ch1 := make(chan string)
	ch2 := make(chan string)

	go func() {
		ch1 <- "salom"
	}()

	fmt.Println(birinchiTayyor(ch1, ch2))
}
