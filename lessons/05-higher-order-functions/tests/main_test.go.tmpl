package main

import (
	"reflect"
	"testing"
)

func TestFilterEven(t *testing.T) {
	juft := func(x int) bool { return x%2 == 0 }
	got := filter([]int{1, 2, 3, 4, 5, 6}, juft)
	want := []int{2, 4, 6}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("filter([1..6], juft):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}

func TestFilterGreaterThan(t *testing.T) {
	katta := func(x int) bool { return x > 5 }
	got := filter([]int{1, 2, 3, 4, 5, 6, 7, 8}, katta)
	want := []int{6, 7, 8}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("filter([1..8], katta>5):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}

func TestFilterNoneMatch(t *testing.T) {
	hech := func(x int) bool { return x > 100 }
	got := filter([]int{1, 2, 3}, hech)
	want := []int{}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("filter([1,2,3], >100):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
