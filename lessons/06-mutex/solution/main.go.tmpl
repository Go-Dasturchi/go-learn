package main

import (
	"fmt"
	"sync"
)

// HavfsizHisoblagich — mutex bilan himoyalangan hisoblagich.
type HavfsizHisoblagich struct {
	mu  sync.Mutex
	son int
}

// Oshir hisoblagichni bittaga xavfsiz oshiradi.
func (h *HavfsizHisoblagich) Oshir() {
	h.mu.Lock()
	defer h.mu.Unlock()
	h.son++
}

func main() {
	h := &HavfsizHisoblagich{}
	var wg sync.WaitGroup

	for i := 0; i < 1000; i++ {
		wg.Add(1)
		go func() {
			defer wg.Done()
			h.Oshir()
		}()
	}
	wg.Wait()

	fmt.Println(h.son)
}
