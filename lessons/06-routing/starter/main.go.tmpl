// yaratMux ikkala handler'ni ham ro'yxatdan o'tkazilgan mux qaytaradi.
func yaratMux() *http.ServeMux {
	// TODO: ikkala handler'ni ro'yxatdan o'tkazing, mux'ni qaytaring
