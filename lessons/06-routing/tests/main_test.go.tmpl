package main

import (
	"net/http/httptest"
	"testing"
)

func TestFoydalanuvchiHandlerDirect(t *testing.T) {
	req := httptest.NewRequest("GET", "/foydalanuvchi/42", nil)
	rec := httptest.NewRecorder()
	foydalanuvchiHandler(rec, req)

	got := rec.Body.String()
	want := "Foydalanuvchi ID: 42"
	if got != want {
		t.Errorf("foydalanuvchiHandler(/foydalanuvchi/42):\nExpected:\n%q\n\nGot:\n%q", want, got)
	}
}

func TestMuxRoutesSalom(t *testing.T) {
	mux := yaratMux()
