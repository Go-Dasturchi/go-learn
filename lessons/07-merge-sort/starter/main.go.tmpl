package main

import "fmt"

// merge ikkita saralangan slice'ni bitta saralangan slice'ga birlashtiradi.
func merge(chap, ong []int) []int {
	natija := []int{}
	i, j := 0, 0
	for i < len(chap) && j < len(ong) {
		if chap[i] <= ong[j] {
			natija = append(natija, chap[i])
			i++
		} else {
			natija = append(natija, ong[j])
			j++
		}
	}
	natija = append(natija, chap[i:]...)
	natija = append(natija, ong[j:]...)
	return natija
}

