// Natija — bitta ishlov natijasi.
type Natija struct {
	Indeks int
	Qiymat int
}

// worker jobs kanalidan sonlarni olib, kvadratini results ga yuboradi.
func worker(jobs <-chan int, results chan<- Natija, wg *sync.WaitGroup) {
	defer wg.Done()
	for son := range jobs {
		results <- Natija{Indeks: son, Qiymat: son * son}
	}
}

