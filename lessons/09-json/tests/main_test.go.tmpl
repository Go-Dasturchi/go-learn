package main

import "testing"

func TestToJSONBasic(t *testing.T) {
	got, err := toJSON(Mahsulot{Nomi: "Non", Narx: 5000})
	if err != nil {
		t.Errorf("toJSON: kutilmagan xato: %v", err)
	}
	want := `{"nomi":"Non","narx":5000}`
	if got != want {
		t.Errorf("toJSON(Non/5000):\nExpected:\n%s\n\nGot:\n%s", want, got)
	}
}

