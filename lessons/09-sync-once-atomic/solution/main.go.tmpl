package main

import (
	"fmt"
	"sync"
	"sync/atomic"
)

// HavfsizHisoblagichAtomic — atomic.Int64 yordamida Mutex'siz
// xavfsiz oshiriladigan hisoblagich.
type HavfsizHisoblagichAtomic struct {
	son atomic.Int64
}

// Oshir hisoblagichni bittaga atomik (bo'linmas) ravishda oshiradi.
func (h *HavfsizHisoblagichAtomic) Oshir() {
	h.son.Add(1)
}

func main() {
	h := &HavfsizHisoblagichAtomic{}
	var wg sync.WaitGroup

	for i := 0; i < 1000; i++ {
		wg.Add(1)
		go func() {
			defer wg.Done()
			h.Oshir()
		}()
	}
	wg.Wait()

	fmt.Println(h.son.Load())
}
