package main

import (
	"sync"
	"testing"
)

func TestOshirAtomicConcurrentSafety(t *testing.T) {
	h := &HavfsizHisoblagichAtomic{}
	var wg sync.WaitGroup

	n := 2000
	for i := 0; i < n; i++ {
		wg.Add(1)
		go func() {
			defer wg.Done()
			h.Oshir()
		}()
	}
	wg.Wait()

	if h.son.Load() != int64(n) {
		t.Errorf("2000 ta goroutine Oshir() chaqirgandan keyin:\nExpected:\n%d\n\nGot:\n%d", n, h.son.Load())
	}
}

func TestOshirAtomicSequential(t *testing.T) {
	h := &HavfsizHisoblagichAtomic{}
	for i := 0; i < 7; i++ {
		h.Oshir()
	}
	if h.son.Load() != 7 {
		t.Errorf("7 marta ketma-ket Oshir():\nExpected:\n7\n\nGot:\n%d", h.son.Load())
	}
}
