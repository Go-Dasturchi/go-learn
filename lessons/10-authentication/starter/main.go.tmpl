// tokenniAjrat "Bearer <token>" ko'rinishidagi sarlavhadan tokenni ajratadi.
func tokenniAjrat(sarlavha string) (string, bool) {
	if !strings.HasPrefix(sarlavha, "Bearer ") {
		return "", false
	}
	token := strings.TrimPrefix(sarlavha, "Bearer ")
	if token == "" {
		return "", false
	}
	return token, true
}

