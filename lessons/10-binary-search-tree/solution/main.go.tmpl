package main

import "fmt"

// Tugun — ikkilik qidiruv daraxtining bitta tuguni.
type Tugun struct {
	Value int
	Left  *Tugun
	Right *Tugun
}

// qidir BST xossasidan foydalanib, qiymat daraxtda bor-yo'qligini tekshiradi.
func qidir(tugun *Tugun, qiymat int) bool {
	if tugun == nil {
		return false
	}
	if tugun.Value == qiymat {
		return true
	}
	if qiymat < tugun.Value {
		return qidir(tugun.Left, qiymat)
	}
	return qidir(tugun.Right, qiymat)
}

func main() {
	ildiz := &Tugun{
		Value: 5,
		Left:  &Tugun{Value: 3, Left: &Tugun{Value: 1}},
		Right: &Tugun{Value: 8, Left: &Tugun{Value: 6}, Right: &Tugun{Value: 9}},
	}
	fmt.Println(qidir(ildiz, 6))
	fmt.Println(qidir(ildiz, 7))
}
