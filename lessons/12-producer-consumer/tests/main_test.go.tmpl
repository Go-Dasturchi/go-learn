package main

import "testing"

func TestIshlabChiqaruvchiIsteMolchiBasic(t *testing.T) {
	got := ishlabChiqaruvchiIsteMolchi([]int{1, 2, 3}, []int{4, 5, 6})
	want := 21
	if got != want {
		t.Errorf("ishlabChiqaruvchiIsteMolchi([1,2,3],[4,5,6]):\nExpected:\n%d\n\nGot:\n%d", want, got)
	}
}

func TestIshlabChiqaruvchiIsteMolchiOneEmpty(t *testing.T) {
	got := ishlabChiqaruvchiIsteMolchi([]int{10, 20}, []int{})
	want := 30
	if got != want {
		t.Errorf("ishlabChiqaruvchiIsteMolchi([10,20],[]):\nExpected:\n%d\n\nGot:\n%d", want, got)
	}
}

func TestIshlabChiqaruvchiIsteMolchiBothEmpty(t *testing.T) {
	got := ishlabChiqaruvchiIsteMolchi([]int{}, []int{})
	want := 0
	if got != want {
		t.Errorf("ishlabChiqaruvchiIsteMolchi([],[]):\nExpected:\n%d\n\nGot:\n%d", want, got)
	}
}

func TestIshlabChiqaruvchiIsteMolchiLarger(t *testing.T) {
	got := ishlabChiqaruvchiIsteMolchi([]int{1, 1, 1, 1, 1}, []int{2, 2, 2, 2, 2})
	want := 15
	if got != want {
		t.Errorf("ishlabChiqaruvchiIsteMolchi(larger):\nExpected:\n%d\n\nGot:\n%d", want, got)
	}
}
