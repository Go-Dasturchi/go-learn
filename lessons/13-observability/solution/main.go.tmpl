package main

import "fmt"

// Metrikalar — Prometheus Counter/Histogram g'oyalarining soddalashtirilgan
// ko'rinishi: so'rovlar sonini va o'rtacha javob vaqtini kuzatadi.
type Metrikalar struct {
	sorovlarSoni int
	jamiVaqtMs   int64
}

// SorovniQayd bitta so'rovning davomiyligini qayd qiladi.
func (m *Metrikalar) SorovniQayd(davomiylikMs int64) {
	m.sorovlarSoni++
	m.jamiVaqtMs += davomiylikMs
}

// OrtachaVaqtMs hozirgacha qayd qilingan so'rovlarning o'rtacha vaqtini qaytaradi.
func (m *Metrikalar) OrtachaVaqtMs() float64 {
	if m.sorovlarSoni == 0 {
		return 0
	}
	return float64(m.jamiVaqtMs) / float64(m.sorovlarSoni)
}

func main() {
	m := &Metrikalar{}

	m.SorovniQayd(100)
	m.SorovniQayd(200)
	m.SorovniQayd(300)

	fmt.Println(m.sorovlarSoni, m.OrtachaVaqtMs())
}
