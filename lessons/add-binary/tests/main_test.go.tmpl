package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve("11", "1")
	var want string = "100"
	if got != want {
		t.Errorf("solve(a = \"11\", b = \"1\"):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve("1010", "1011")
	var want string = "10101"
	if got != want {
		t.Errorf("solve(a = \"1010\", b = \"1011\"):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
