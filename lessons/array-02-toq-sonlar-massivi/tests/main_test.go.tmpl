package main

import (
	"reflect"
	"testing"
)

func TestOddNumbersCase1(t *testing.T) {
	got := oddNumbers(5)
	want := []int{1, 3, 5, 7, 9}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("oddNumbers(N=5):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestOddNumbersCase2(t *testing.T) {
	got := oddNumbers(3)
	want := []int{1, 3, 5}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("oddNumbers(N=3):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestOddNumbersCase3(t *testing.T) {
	got := oddNumbers(7)
	want := []int{1, 3, 5, 7, 9, 11, 13}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("oddNumbers(N=7):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
