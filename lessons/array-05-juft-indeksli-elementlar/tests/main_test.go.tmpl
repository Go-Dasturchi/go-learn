package main

import (
	"testing"
)

func TestEvenIndexElementsCase1(t *testing.T) {
	got := evenIndexElements(6, []int{1, 2, 3, 4, 5, 6})
	want := "1, 3, 5"
	if got != want {
		t.Errorf("evenIndexElements(N=6, arr=[1,2,3,4,5,6]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestEvenIndexElementsCase2(t *testing.T) {
	got := evenIndexElements(5, []int{10, 20, 30, 40, 50})
	want := "10, 30, 50"
	if got != want {
		t.Errorf("evenIndexElements(N=5, arr=[10,20,30,40,50]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestEvenIndexElementsCase3(t *testing.T) {
	got := evenIndexElements(4, []int{7, 3, 9, 1})
