package main

import (
	"reflect"
	"testing"
)

func TestOddIndexElementsCase1(t *testing.T) {
	got := oddIndexElements(6, []int{1, 2, 3, 4, 5, 6})
	want := []int{6, 4, 2}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("oddIndexElements(N=6, arr=[1,2,3,4,5,6]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestOddIndexElementsCase2(t *testing.T) {
	got := oddIndexElements(5, []int{10, 20, 30, 40, 50})
	want := []int{40, 20}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("oddIndexElements(N=5, arr=[10,20,30,40,50]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestOddIndexElementsCase3(t *testing.T) {
	got := oddIndexElements(4, []int{7, 3, 9, 1})
	want := []int{1, 3}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("oddIndexElements(N=4, arr=[7,3,9,1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
