func TestCountGreaterKCase1(t *testing.T) {
	got := countGreaterK(6, 5, []int{3, 7, 2, 9, 1, 8})
	want := 3
	if got != want {
		t.Errorf("countGreaterK(N=6, K=5, arr=[3,7,2,9,1,8]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
