package main

import "fmt"

func firstLastPositive(arr []int) string {
	first := -1
	last := -1
	for i := 0; i < len(arr); i++ {
		if arr[i] > 0 {
			if first == -1 {
				first = i
			}
			last = i
		}
	}
	return fmt.Sprintf("first=%d, last=%d", first, last)
}

func main() {
	fmt.Println(firstLastPositive([]int{-1, 5, -3, 8, -2, 3}))
}
