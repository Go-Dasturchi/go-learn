package main

import (
	"reflect"
	"testing"
)

func TestReverseArrCase1(t *testing.T) {
	got := reverseArr(5, []int{1, 2, 3, 4, 5})
	want := []int{5, 4, 3, 2, 1}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("reverseArr(N=5, arr=[1,2,3,4,5]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestReverseArrCase2(t *testing.T) {
	got := reverseArr(4, []int{10, 20, 30, 40})
	want := []int{40, 30, 20, 10}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("reverseArr(N=4, arr=[10,20,30,40]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestReverseArrCase3(t *testing.T) {
	got := reverseArr(6, []int{1, 3, 5, 7, 9, 11})
	want := []int{11, 9, 7, 5, 3, 1}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("reverseArr(N=6, arr=[1,3,5,7,9,11]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
