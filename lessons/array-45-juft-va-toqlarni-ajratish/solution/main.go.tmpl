package main

import "fmt"

func separateEvenOdd(N int, arr []int) []int {
	natija := []int{}
	for i := 0; i < N; i++ {
		if arr[i]%2 == 0 {
			natija = append(natija, arr[i])
		}
	}
	for i := 0; i < N; i++ {
		if arr[i]%2 != 0 {
			natija = append(natija, arr[i])
		}
	}
	return natija
}

func main() {
	fmt.Println(separateEvenOdd(6, []int{1, 2, 3, 4, 5, 6}))
}
