package main

import (
	"reflect"
	"testing"
)

func TestSeparateEvenOddCase1(t *testing.T) {
	got := separateEvenOdd(6, []int{1, 2, 3, 4, 5, 6})
	want := []int{2, 4, 6, 1, 3, 5}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("separateEvenOdd(N=6, arr=[1,2,3,4,5,6]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSeparateEvenOddCase2(t *testing.T) {
	got := separateEvenOdd(5, []int{7, 8, 3, 10, 1})
	want := []int{8, 10, 7, 3, 1}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("separateEvenOdd(N=5, arr=[7,8,3,10,1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSeparateEvenOddCase3(t *testing.T) {
	got := separateEvenOdd(4, []int{1, 3, 5, 7})
	want := []int{1, 3, 5, 7}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("separateEvenOdd(N=4, arr=[1,3,5,7]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
