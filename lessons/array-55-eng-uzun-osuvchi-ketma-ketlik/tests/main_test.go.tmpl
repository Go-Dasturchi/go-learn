package main

import (
	"testing"
)

func TestLongestIncreasingCase1(t *testing.T) {
	got := longestIncreasing(8, []int{1, 2, 3, 1, 2, 3, 4, 5})
	want := 4
	if got != want {
		t.Errorf("longestIncreasing(N=8, arr=[1,2,3,1,2,3,4,5]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestLongestIncreasingCase2(t *testing.T) {
	got := longestIncreasing(6, []int{5, 4, 3, 2, 1, 6})
	want := 1
	if got != want {
		t.Errorf("longestIncreasing(N=6, arr=[5,4,3,2,1,6]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestLongestIncreasingCase3(t *testing.T) {
	got := longestIncreasing(5, []int{1, 3, 2, 4, 5})
	want := 3
	if got != want {
		t.Errorf("longestIncreasing(N=5, arr=[1,3,2,4,5]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
