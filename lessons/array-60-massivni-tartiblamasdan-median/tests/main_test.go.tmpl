package main

import (
	"math"
	"testing"
)

func TestMedianUnsortedCase1(t *testing.T) {
	got := medianUnsorted(5, []int{3, 7, 2, 9, 1})
	var want float64 = 3
	if math.Abs(got-want) > 1e-6 {
		t.Errorf("medianUnsorted(N=5, arr=[3,7,2,9,1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
