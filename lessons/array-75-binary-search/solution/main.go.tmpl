package main

import "fmt"

func binarySearch(N int, K int, arr []int) int {
	lo, hi := 0, N-1
	for lo <= hi {
		mid := (lo + hi) / 2
		if arr[mid] == K {
			return mid
		} else if arr[mid] < K {
			lo = mid + 1
		} else {
			hi = mid - 1
		}
	}
	return -1
}

func main() {
	fmt.Println(binarySearch(7, 5, []int{1, 2, 3, 5, 7, 9, 11}))
}
