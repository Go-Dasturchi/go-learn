package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve("(1+(4+5+2)-3)+(6+8)")
	var want int = 23
	if got != want {
		t.Errorf("solve(s = \"(1+(4+5+2)-3)+(6+8)\"):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
