package main

import (
	"math"
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve(10, 20)
	want := 15.0
	if math.Abs(got-want) > 1e-6 {
		t.Errorf("solve(a=10, b=20):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
