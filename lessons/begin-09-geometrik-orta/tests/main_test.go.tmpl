package main

import (
	"math"
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve(4, 9)
	want := 6.0
	if math.Abs(got-want) > 1e-6 {
		t.Errorf("solve(a=4, b=9):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
