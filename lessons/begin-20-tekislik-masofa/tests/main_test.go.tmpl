package main

import (
	"math"
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve(0, 0, 3, 4)
	want := 5.0
	if math.Abs(got-want) > 1e-6 {
		t.Errorf("solve(x1=0, y1=0, x2=3, y2=4):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
