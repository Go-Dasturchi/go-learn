package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{7, 1, 5, 3, 6, 4})
	var want int = 5
	if got != want {
		t.Errorf("solve(prices = [7,1,5,3,6,4]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{7, 6, 4, 3, 1})
	var want int = 0
	if got != want {
		t.Errorf("solve(prices = [7,6,4,3,1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
