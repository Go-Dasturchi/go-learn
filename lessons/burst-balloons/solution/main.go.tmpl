package main

import "fmt"

func solve(nums []int) int {
	n := len(nums)
	balloons := make([]int, n+2)
	balloons[0] = 1
	balloons[n+1] = 1
	for i := 0; i < n; i++ {
		balloons[i+1] = nums[i]
	}

	dp := make([][]int, n+2)
	for i := range dp {
		dp[i] = make([]int, n+2)
	}

	for length := 1; length <= n; length++ {
		for left := 1; left <= n-length+1; left++ {
			right := left + length - 1
			for k := left; k <= right; k++ {
				coins := balloons[left-1]*balloons[k]*balloons[right+1] + dp[left][k-1] + dp[k+1][right]
				if coins > dp[left][right] {
					dp[left][right] = coins
				}
			}
		}
	}

	return dp[1][n]
}

func main() {
	fmt.Println(solve([]int{3, 1, 5, 8}))
}
