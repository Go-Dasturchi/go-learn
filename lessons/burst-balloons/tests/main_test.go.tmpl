package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{3, 1, 5, 8})
	var want int = 167
	if got != want {
		t.Errorf("solve(nums = [3,1,5,8]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{1, 5})
	var want int = 10
	if got != want {
		t.Errorf("solve(nums = [1,5]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
