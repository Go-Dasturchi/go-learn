package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{1, 0, 2})
	var want int = 5
	if got != want {
		t.Errorf("solve(ratings = [1,0,2]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{1, 2, 2})
	var want int = 4
	if got != want {
		t.Errorf("solve(ratings = [1,2,2]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
	got := solve([]int{1, 3, 4, 5, 2})
	var want int = 11
	if got != want {
		t.Errorf("solve(ratings = [1,3,4,5,2]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
