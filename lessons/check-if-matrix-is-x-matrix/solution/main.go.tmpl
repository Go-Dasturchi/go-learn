package main

import "fmt"

func solve(grid [][]int) bool {
	n := len(grid)
	for i := 0; i < n; i++ {
		for j := 0; j < n; j++ {
			onDiagonal := i == j || i+j == n-1
			if onDiagonal {
				if grid[i][j] == 0 {
					return false
				}
			} else {
				if grid[i][j] != 0 {
					return false
				}
			}
		}
	}
	return true
}

func main() {
	fmt.Println(solve([][]int{[]int{2, 0, 0, 1}, []int{0, 3, 1, 0}, []int{0, 5, 2, 0}, []int{4, 0, 0, 2}}))
}
