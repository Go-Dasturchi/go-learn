package main

import (
	"reflect"
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve(4, 2)
	var want [][]int = [][]int{[]int{1, 2}, []int{1, 3}, []int{1, 4}, []int{2, 3}, []int{2, 4}, []int{3, 4}}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(n = 4, k = 2):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve(1, 1)
	var want [][]int = [][]int{[]int{1}}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(n = 1, k = 1):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
