package main

import "fmt"

func solve(height []int) int {
	l, r := 0, len(height)-1
	best := 0
	for l < r {
		h := height[l]
		if height[r] < h {
			h = height[r]
		}
		area := h * (r - l)
		if area > best {
			best = area
		}
		if height[l] < height[r] {
			l++
		} else {
			r--
		}
	}
	return best
}

func main() {
	fmt.Println(solve([]int{1, 8, 6, 2, 5, 4, 8, 3, 7}))
}
