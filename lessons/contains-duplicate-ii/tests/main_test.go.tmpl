package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{1, 2, 3, 1}, 3)
	var want bool = true
	if got != want {
		t.Errorf("solve(nums = [1,2,3,1], k = 3):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{1, 0, 1, 1}, 1)
	var want bool = true
	if got != want {
		t.Errorf("solve(nums = [1,0,1,1], k = 1):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
	got := solve([]int{1, 2, 3, 1, 2, 3}, 2)
	var want bool = false
	if got != want {
		t.Errorf("solve(nums = [1,2,3,1,2,3], k = 2):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
