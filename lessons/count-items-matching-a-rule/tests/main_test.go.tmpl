package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([][]string{[]string{"phone", "blue", "pixel"}, []string{"computer", "silver", "lenovo"}, []string{"phone", "gold", "iphone"}}, "color", "silver")
	var want int = 1
	if got != want {
		t.Errorf("solve(items = [[\"phone\",\"blue\",\"pixel\"],[\"computer\",\"silver\",\"lenovo\"],[\"phone\",\"gold\",\"iphone\"]], ruleKey = \"color\", ruleValue = \"silver\"):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([][]string{[]string{"phone", "blue", "pixel"}, []string{"computer", "silver", "phone"}, []string{"phone", "gold", "iphone"}}, "type", "phone")
	var want int = 2
	if got != want {
		t.Errorf("solve(items = [[\"phone\",\"blue\",\"pixel\"],[\"computer\",\"silver\",\"phone\"],[\"phone\",\"gold\",\"iphone\"]], ruleKey = \"type\", ruleValue = \"phone\"):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
