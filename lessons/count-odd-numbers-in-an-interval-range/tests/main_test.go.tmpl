package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve(3, 7)
	var want int = 3
	if got != want {
		t.Errorf("solve(low = 3, high = 7):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
