package main

import (
	"reflect"
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{5, 2, 6, 1})
	var want []int = []int{2, 1, 1, 0}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(nums = [5,2,6,1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{-1})
	var want []int = []int{0}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(nums = [-1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
	got := solve([]int{-1, -1})
	var want []int = []int{0, 0}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(nums = [-1,-1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
