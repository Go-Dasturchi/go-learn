package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve(2, 3)
	var want int = 3
	if got != want {
		t.Errorf("solve(num1 = 2, num2 = 3):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
