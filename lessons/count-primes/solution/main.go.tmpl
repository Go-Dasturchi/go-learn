package main

import "fmt"

func solve(n int) int {
	if n < 3 {
		return 0
	}
	isComposite := make([]bool, n)
	count := 0
	for i := 2; i < n; i++ {
		if !isComposite[i] {
			count++
			for j := i * i; j < n; j += i {
				isComposite[j] = true
			}
		}
	}
	return count
}

func main() {
	fmt.Println(solve(10))
}
