package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve("horse", "ros")
	var want int = 3
	if got != want {
		t.Errorf("solve(word1 = \"horse\", word2 = \"ros\"):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
