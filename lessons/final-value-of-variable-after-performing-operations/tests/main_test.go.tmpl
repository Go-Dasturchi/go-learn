package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]string{"--X", "X++", "X++"})
	var want int = 1
	if got != want {
		t.Errorf("solve(operations = [\"--X\",\"X++\",\"X++\"]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]string{"++X", "++X", "X++"})
	var want int = 3
	if got != want {
		t.Errorf("solve(operations = [\"++X\",\"++X\",\"X++\"]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
	got := solve([]string{"X++", "++X", "--X", "X--"})
	var want int = 0
	if got != want {
		t.Errorf("solve(operations = [\"X++\",\"++X\",\"--X\",\"X--\"]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
