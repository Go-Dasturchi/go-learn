package main

import "fmt"

func solve(nums []int) []int {
	n := len(nums)
	present := make([]bool, n+1)
	for _, v := range nums {
		present[v] = true
	}
	result := []int{}
	for i := 1; i <= n; i++ {
		if !present[i] {
			result = append(result, i)
		}
	}
	return result
}

func main() {
	fmt.Println(solve([]int{4, 3, 2, 7, 8, 2, 3, 1}))
}
