package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([][]int{[]int{1, 2}, []int{2, 3}, []int{4, 2}})
	var want int = 2
	if got != want {
		t.Errorf("solve(edges = [[1,2],[2,3],[4,2]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([][]int{[]int{1, 2}, []int{5, 1}, []int{1, 3}, []int{1, 4}})
	var want int = 1
	if got != want {
		t.Errorf("solve(edges = [[1,2],[5,1],[1,3],[1,4]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
