package main

import "fmt"

func solve(nums []int, target int) []int {
	lower := func() int {
		lo, hi := 0, len(nums)
		for lo < hi {
			mid := (lo + hi) / 2
			if nums[mid] < target {
				lo = mid + 1
			} else {
				hi = mid
			}
		}
		return lo
	}
	upper := func() int {
		lo, hi := 0, len(nums)
		for lo < hi {
			mid := (lo + hi) / 2
			if nums[mid] <= target {
				lo = mid + 1
			} else {
				hi = mid
			}
		}
		return lo
	}
	start := lower()
	if start == len(nums) || nums[start] != target {
		return []int{-1, -1}
	}
	end := upper() - 1
	return []int{start, end}
}

func main() {
	fmt.Println(solve([]int{5, 7, 7, 8, 8, 10}, 8))
}
