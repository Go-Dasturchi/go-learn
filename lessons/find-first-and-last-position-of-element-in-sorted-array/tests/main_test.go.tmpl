package main

import (
	"reflect"
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{5, 7, 7, 8, 8, 10}, 8)
	var want []int = []int{3, 4}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(nums = [5,7,7,8,8,10], target = 8):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{5, 7, 7, 8, 8, 10}, 6)
	var want []int = []int{-1, -1}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(nums = [5,7,7,8,8,10], target = 6):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
	got := solve([]int{}, 0)
	var want []int = []int{-1, -1}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(nums = [], target = 0):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
