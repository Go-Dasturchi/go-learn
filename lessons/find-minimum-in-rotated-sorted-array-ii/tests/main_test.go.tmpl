package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{2, 2, 2, 0, 1})
	var want int = 0
	if got != want {
		t.Errorf("solve(nums = [2,2,2,0,1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
