package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{1, 2, 3, 1})
	var want int = 2
	if got != want {
		t.Errorf("solve(nums = [1,2,3,1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{1, 2, 1, 3, 5, 6, 4})
	var want int = 5
	if got != want {
		t.Errorf("solve(nums = [1,2,1,3,5,6,4]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
	got := solve([]int{1})
	var want int = 0
	if got != want {
		t.Errorf("solve(nums = [1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
