package main

import (
	"reflect"
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]string{"abba", "baba", "bbaa", "cd", "cd"})
	var want []string = []string{"abba", "cd"}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(words = [\"abba\",\"baba\",\"bbaa\",\"cd\",\"cd\"]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]string{"a", "b", "c", "d", "e"})
	var want []string = []string{"a", "b", "c", "d", "e"}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(words = [\"a\",\"b\",\"c\",\"d\",\"e\"]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
