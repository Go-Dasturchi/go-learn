package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve("abcd", "abcde")
	var want string = "e"
	if got != want {
		t.Errorf("solve(s = \"abcd\", t = \"abcde\"):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve("", "y")
	var want string = "y"
	if got != want {
		t.Errorf("solve(s = \"\", t = \"y\"):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
