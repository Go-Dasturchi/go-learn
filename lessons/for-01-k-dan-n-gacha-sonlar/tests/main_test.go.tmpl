package main

import (
	"testing"
)

func TestRangeKtoNCase1(t *testing.T) {
	got := rangeKtoN(3, 7)
	var want string = "3 4 5 6 7"
	if got != want {
		t.Errorf("rangeKtoN(K=3, N=7):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
