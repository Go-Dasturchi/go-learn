package main

import (
	"testing"
)

func TestBreadPricesCase1(t *testing.T) {
	got := breadPrices(5)
	want := "6.0, 7.0, 8.0, 9.0, 10.0"
	if got != want {
		t.Errorf("breadPrices(A=5):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
