package main

import (
	"testing"
)

func TestAllPowersCase1(t *testing.T) {
	got := allPowers(2)
	want := "4, 8, 16, 32"
	if got != want {
		t.Errorf("allPowers(N=2):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
