package main

import (
	"testing"
)

func TestMinAndMaxNCase1(t *testing.T) {
	got := minAndMaxN(5, []int{3, 7, 2, 9, 1})
	want := "max=9, min=1"
	if got != want {
		t.Errorf("minAndMaxN(N=5, nums=[3,7,2,9,1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
