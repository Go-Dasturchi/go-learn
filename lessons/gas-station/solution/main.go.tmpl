package main

import "fmt"

func solve(gas []int, cost []int) int {
	total := 0
	tank := 0
	start := 0
	for i := 0; i < len(gas); i++ {
		diff := gas[i] - cost[i]
		total += diff
		tank += diff
		if tank < 0 {
			start = i + 1
			tank = 0
		}
	}
	if total < 0 {
		return -1
	}
	return start
}

func main() {
	fmt.Println(solve([]int{1, 2, 3, 4, 5}, []int{3, 4, 5, 1, 2}))
}
