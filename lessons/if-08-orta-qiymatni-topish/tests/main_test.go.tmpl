package main

import (
	"testing"
)

func TestMiddleValueCase1(t *testing.T) {
	got := middleValue(5, 3, 7)
	want := 5
	if got != want {
		t.Errorf("middleValue(A=5, B=3, C=7):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
