package main

import (
	"testing"
)

func TestTriangleTypeCase1(t *testing.T) {
	got := triangleType(5, 5, 5)
	want := "Teng tomonli"
	if got != want {
		t.Errorf("triangleType(A=5, B=5, C=5):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestTriangleTypeCase2(t *testing.T) {
	got := triangleType(5, 5, 3)
	want := "Teng yonli"
	if got != want {
		t.Errorf("triangleType(A=5, B=5, C=3):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestTriangleTypeCase3(t *testing.T) {
	got := triangleType(3, 4, 5)
