package main

import (
	"testing"
)

func TestSolveQuadraticCase1(t *testing.T) {
	got := solveQuadratic(1, -3, 2)
	want := 2
	if got != want {
		t.Errorf("solveQuadratic(A=1, B=-3, C=2):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveQuadraticCase2(t *testing.T) {
	got := solveQuadratic(1, -2, 1)
	want := 1
	if got != want {
		t.Errorf("solveQuadratic(A=1, B=-2, C=1):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveQuadraticCase3(t *testing.T) {
	got := solveQuadratic(1, 0, 1)
	want := 0
	if got != want {
		t.Errorf("solveQuadratic(A=1, B=0, C=1):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
