package main

import (
	"testing"
)

func TestIsInsideRectCase1(t *testing.T) {
	got := isInsideRect(0, 0, 10, 10, 5, 5)
	want := "Ichida"
	if got != want {
		t.Errorf("isInsideRect(x1=0, y1=0, x2=10, y2=10, x=5, y=5):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
