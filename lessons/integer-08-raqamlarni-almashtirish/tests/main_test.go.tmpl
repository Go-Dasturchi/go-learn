package main

import (
	"testing"
)

func TestSwapDigitsCase1(t *testing.T) {
	got := swapDigits(47)
	want := 74
	if got != want {
		t.Errorf("swapDigits(n=47):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
