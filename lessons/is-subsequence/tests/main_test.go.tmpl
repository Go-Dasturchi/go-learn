package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve("abc", "ahbgdc")
	var want bool = true
	if got != want {
		t.Errorf("solve(s = \"abc\", t = \"ahbgdc\"):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve("axc", "ahbgdc")
	var want bool = false
	if got != want {
		t.Errorf("solve(s = \"axc\", t = \"ahbgdc\"):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
