package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve("egg", "add")
	var want bool = true
	if got != want {
		t.Errorf("solve(s = \"egg\", t = \"add\"):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
