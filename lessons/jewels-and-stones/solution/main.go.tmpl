package main

import "fmt"

func solve(jewels string, stones string) int {
	jewelSet := make(map[byte]bool)
	for i := 0; i < len(jewels); i++ {
		jewelSet[jewels[i]] = true
	}
	count := 0
	for i := 0; i < len(stones); i++ {
		if jewelSet[stones[i]] {
			count++
		}
	}
	return count
}

func main() {
	fmt.Println(solve("aA", "aAAbbbb"))
}
