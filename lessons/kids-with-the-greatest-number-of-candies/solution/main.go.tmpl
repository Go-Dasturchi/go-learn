package main

import "fmt"

func solve(candies []int, extraCandies int) []bool {
	maxCandies := 0
	for _, c := range candies {
		if c > maxCandies {
			maxCandies = c
		}
	}
	result := make([]bool, len(candies))
	for i, c := range candies {
		result[i] = c+extraCandies >= maxCandies
	}
	return result
}

func main() {
	fmt.Println(solve([]int{2, 3, 5, 1, 3}, 3))
}
