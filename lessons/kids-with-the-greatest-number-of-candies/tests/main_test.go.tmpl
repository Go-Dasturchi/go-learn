package main

import (
	"reflect"
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{2, 3, 5, 1, 3}, 3)
	var want []bool = []bool{true, true, true, false, true}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(candies = [2,3,5,1,3], extraCandies = 3):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{4, 2, 1, 1, 2}, 1)
	var want []bool = []bool{true, false, false, false, false}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(candies = [4,2,1,1,2], extraCandies = 1):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
	got := solve([]int{12, 1, 12}, 10)
	var want []bool = []bool{true, false, true}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(candies = [12,1,12], extraCandies = 10):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
