package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{3, 6, 1, 0})
	var want int = 1
	if got != want {
		t.Errorf("solve(nums = [3,6,1,0]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{1, 2, 3, 4})
	var want int = -1
	if got != want {
		t.Errorf("solve(nums = [1,2,3,4]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
	got := solve([]int{0, 0, 0, 1})
	var want int = 3
	if got != want {
		t.Errorf("solve(nums = [0,0,0,1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
