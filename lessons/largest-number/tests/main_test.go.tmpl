package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{10, 2})
	var want string = "210"
	if got != want {
		t.Errorf("solve(nums = [10,2]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{3, 30, 34, 5, 9})
	var want string = "9534330"
	if got != want {
		t.Errorf("solve(nums = [3,30,34,5,9]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
