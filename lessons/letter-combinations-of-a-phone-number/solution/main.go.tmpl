package main

import "fmt"

func solve(digits string) []string {
	if len(digits) == 0 {
		return []string{}
	}
	letters := map[byte]string{
		'2': "abc", '3': "def", '4': "ghi", '5': "jkl",
		'6': "mno", '7': "pqrs", '8': "tuv", '9': "wxyz",
	}
	res := []string{}
	var backtrack func(idx int, cur string)
	backtrack = func(idx int, cur string) {
		if idx == len(digits) {
			res = append(res, cur)
			return
		}
		for _, ch := range letters[digits[idx]] {
			backtrack(idx+1, cur+string(ch))
		}
	}
	backtrack(0, "")
	return res
}

func main() {
	fmt.Println(solve("23"))
}
