package main

import (
	"reflect"
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve(2, []string{"put", "put", "get", "put", "get", "get", "put", "get", "get", "get"}, [][]int{[]int{1, 1}, []int{2, 2}, []int{1}, []int{3, 3}, []int{2}, []int{3}, []int{4, 4}, []int{1}, []int{3}, []int{4}})
	var want []int = []int{1, -1, 3, -1, 3, 4}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(capacity = 2, ops = [\"put\", \"put\", \"get\", \"put\", \"get\", \"get\", \"put\", \"get\", \"get\", \"get\"], args = [[1, 1], [2, 2], [1], [3, 3], [2], [3], [4, 4], [1], [3], [4]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
