package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{1, 2, 0, 3}, 0)
	var want bool = true
	if got != want {
		t.Errorf("solve(next = [1,2,0,3], start = 0):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{1, -1}, 0)
	var want bool = false
	if got != want {
		t.Errorf("solve(next = [1,-1], start = 0):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
	got := solve([]int{0}, 0)
	var want bool = true
	if got != want {
		t.Errorf("solve(next = [0], start = 0):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
