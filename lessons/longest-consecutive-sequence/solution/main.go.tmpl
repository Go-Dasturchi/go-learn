package main

import "fmt"

func solve(nums []int) int {
	set := make(map[int]bool, len(nums))
	for _, n := range nums {
		set[n] = true
	}
	best := 0
	for n := range set {
		if set[n-1] {
			continue
		}
		length := 1
		cur := n
		for set[cur+1] {
			cur++
			length++
		}
		if length > best {
			best = length
		}
	}
	return best
}

func main() {
	fmt.Println(solve([]int{100, 4, 200, 1, 3, 2}))
}
