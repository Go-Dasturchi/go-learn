package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve(")()())")
	var want int = 4
	if got != want {
		t.Errorf("solve(s = \")()())\"):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
