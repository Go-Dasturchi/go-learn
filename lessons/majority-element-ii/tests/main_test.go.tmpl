package main

import (
	"reflect"
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{3, 2, 3})
	var want []int = []int{3}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(nums = [3,2,3]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{1, 2})
	var want []int = []int{1, 2}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(nums = [1,2]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
	got := solve([]int{1, 1, 1, 3, 3, 2, 2, 2})
	var want []int = []int{1, 2}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(nums = [1,1,1,3,3,2,2,2]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
