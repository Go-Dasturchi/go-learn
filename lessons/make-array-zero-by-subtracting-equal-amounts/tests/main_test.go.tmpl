package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{1, 5, 0, 3, 5})
	var want int = 3
	if got != want {
		t.Errorf("solve(nums = [1,5,0,3,5]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{0})
	var want int = 0
	if got != want {
		t.Errorf("solve(nums = [0]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
