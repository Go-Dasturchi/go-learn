package main

import (
	"reflect"
	"testing"
)

func TestCreateMatrixCase1(t *testing.T) {
	got := createMatrix(2, 3)
	want := [][]int{[]int{1, 2, 3}, []int{4, 5, 6}}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("createMatrix(M=2, N=3):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestCreateMatrixCase2(t *testing.T) {
	got := createMatrix(3, 2)
	want := [][]int{[]int{1, 2}, []int{3, 4}, []int{5, 6}}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("createMatrix(M=3, N=2):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestCreateMatrixCase3(t *testing.T) {
	got := createMatrix(3, 3)
	want := [][]int{[]int{1, 2, 3}, []int{4, 5, 6}, []int{7, 8, 9}}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("createMatrix(M=3, N=3):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
