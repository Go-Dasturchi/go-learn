package main

import (
	"testing"
)

func TestDiagonalSumCase1(t *testing.T) {
	got := diagonalSum(3, [][]int{[]int{1, 2, 3}, []int{4, 5, 6}, []int{7, 8, 9}})
	want := 15
	if got != want {
		t.Errorf("diagonalSum(N=3, matrix=[[1,2,3],[4,5,6],[7,8,9]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestDiagonalSumCase2(t *testing.T) {
	got := diagonalSum(4, [][]int{[]int{1, 0, 0, 0}, []int{0, 2, 0, 0}, []int{0, 0, 3, 0}, []int{0, 0, 0, 4}})
	want := 10
	if got != want {
		t.Errorf("diagonalSum(N=4, matrix=[[1,0,0,0],[0,2,0,0],[0,0,3,0],[0,0,0,4]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestDiagonalSumCase3(t *testing.T) {
	got := diagonalSum(2, [][]int{[]int{5, 10}, []int{15, 20}})
	want := 25
	if got != want {
		t.Errorf("diagonalSum(N=2, matrix=[[5,10],[15,20]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
