package main

import (
	"testing"
)

func TestRowSumsCase1(t *testing.T) {
	got := rowSums(3, 3, [][]int{[]int{1, 2, 3}, []int{4, 5, 6}, []int{7, 8, 9}})
	want := "6, 15, 24"
	if got != want {
		t.Errorf("rowSums(M=3, N=3, matrix=[[1,2,3],[4,5,6],[7,8,9]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestRowSumsCase2(t *testing.T) {
	got := rowSums(2, 4, [][]int{[]int{1, 2, 3, 4}, []int{5, 6, 7, 8}})
	want := "10, 26"
	if got != want {
		t.Errorf("rowSums(M=2, N=4, matrix=[[1,2,3,4],[5,6,7,8]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestRowSumsCase3(t *testing.T) {
	got := rowSums(4, 2, [][]int{[]int{10, 20}, []int{30, 40}, []int{50, 60}, []int{70, 80}})
	want := "30, 70, 110, 150"
	if got != want {
		t.Errorf("rowSums(M=4, N=2, matrix=[[10,20],[30,40],[50,60],[70,80]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
