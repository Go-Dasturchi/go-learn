package main

import (
	"fmt"
	"strconv"
	"strings"
)

func columnSums(M int, N int, matrix [][]int) string {
	parts := make([]string, N)
	for j := 0; j < N; j++ {
		sum := 0
		for i := 0; i < M; i++ {
			sum += matrix[i][j]
		}
		parts[j] = strconv.Itoa(sum)
	}
	return strings.Join(parts, ", ")
}

func main() {
	fmt.Println(columnSums(3, 3, [][]int{[]int{1, 2, 3}, []int{4, 5, 6}, []int{7, 8, 9}}))
}
