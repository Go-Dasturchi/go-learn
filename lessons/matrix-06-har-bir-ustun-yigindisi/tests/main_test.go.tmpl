package main

import (
	"testing"
)

func TestColumnSumsCase1(t *testing.T) {
	got := columnSums(3, 3, [][]int{[]int{1, 2, 3}, []int{4, 5, 6}, []int{7, 8, 9}})
	want := "12, 15, 18"
	if got != want {
		t.Errorf("columnSums(M=3, N=3, matrix=[[1,2,3],[4,5,6],[7,8,9]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestColumnSumsCase2(t *testing.T) {
	got := columnSums(2, 4, [][]int{[]int{1, 2, 3, 4}, []int{5, 6, 7, 8}})
	want := "6, 8, 10, 12"
	if got != want {
		t.Errorf("columnSums(M=2, N=4, matrix=[[1,2,3,4],[5,6,7,8]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestColumnSumsCase3(t *testing.T) {
	got := columnSums(4, 2, [][]int{[]int{10, 20}, []int{30, 40}, []int{50, 60}, []int{70, 80}})
	want := "160, 200"
	if got != want {
		t.Errorf("columnSums(M=4, N=2, matrix=[[10,20],[30,40],[50,60],[70,80]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
