package main

import "fmt"

func maxElementPosition(M int, N int, matrix [][]int) string {
	maxVal := matrix[0][0]
	maxI, maxJ := 0, 0
	for i := 0; i < M; i++ {
		for j := 0; j < N; j++ {
			if matrix[i][j] > maxVal {
				maxVal = matrix[i][j]
				maxI, maxJ = i, j
			}
		}
	}
	return fmt.Sprintf("max=%d, pos=(%d,%d)", maxVal, maxI, maxJ)
}

func main() {
	fmt.Println(maxElementPosition(3, 3, [][]int{[]int{1, 2, 3}, []int{4, 9, 6}, []int{7, 8, 5}}))
}
