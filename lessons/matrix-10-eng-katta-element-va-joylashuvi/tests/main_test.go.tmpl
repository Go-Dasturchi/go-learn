package main

import (
	"testing"
)

func TestMaxElementPositionCase1(t *testing.T) {
	got := maxElementPosition(3, 3, [][]int{[]int{1, 2, 3}, []int{4, 9, 6}, []int{7, 8, 5}})
	want := "max=9, pos=(1,1)"
	if got != want {
		t.Errorf("maxElementPosition(M=3, N=3, matrix=[[1,2,3],[4,9,6],[7,8,5]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestMaxElementPositionCase2(t *testing.T) {
	got := maxElementPosition(2, 4, [][]int{[]int{10, 20, 30, 40}, []int{50, 60, 70, 80}})
	want := "max=80, pos=(1,3)"
	if got != want {
		t.Errorf("maxElementPosition(M=2, N=4, matrix=[[10,20,30,40],[50,60,70,80]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestMaxElementPositionCase3(t *testing.T) {
	got := maxElementPosition(3, 2, [][]int{[]int{5, 15}, []int{25, 10}, []int{20, 30}})
	want := "max=30, pos=(2,1)"
	if got != want {
		t.Errorf("maxElementPosition(M=3, N=2, matrix=[[5,15],[25,10],[20,30]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
