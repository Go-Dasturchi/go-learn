package main

import "fmt"

func transpose(M int, N int, matrix [][]int) [][]int {
	result := make([][]int, N)
	for j := 0; j < N; j++ {
		row := make([]int, M)
		for i := 0; i < M; i++ {
			row[i] = matrix[i][j]
		}
		result[j] = row
	}
	return result
}

func main() {
	fmt.Println(transpose(2, 3, [][]int{[]int{1, 2, 3}, []int{4, 5, 6}}))
}
