package main

import (
	"reflect"
	"testing"
)

func TestTransposeCase1(t *testing.T) {
	got := transpose(2, 3, [][]int{[]int{1, 2, 3}, []int{4, 5, 6}})
	want := [][]int{[]int{1, 4}, []int{2, 5}, []int{3, 6}}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("transpose(M=2, N=3, matrix=[[1,2,3],[4,5,6]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestTransposeCase2(t *testing.T) {
	got := transpose(3, 2, [][]int{[]int{10, 20}, []int{30, 40}, []int{50, 60}})
	want := [][]int{[]int{10, 30, 50}, []int{20, 40, 60}}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("transpose(M=3, N=2, matrix=[[10,20],[30,40],[50,60]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestTransposeCase3(t *testing.T) {
	got := transpose(3, 3, [][]int{[]int{1, 2, 3}, []int{4, 5, 6}, []int{7, 8, 9}})
	want := [][]int{[]int{1, 4, 7}, []int{2, 5, 8}, []int{3, 6, 9}}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("transpose(M=3, N=3, matrix=[[1,2,3],[4,5,6],[7,8,9]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
