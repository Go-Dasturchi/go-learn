package main

import (
	"reflect"
	"testing"
)

func TestAddMatricesCase1(t *testing.T) {
	got := addMatrices(2, 2, [][]int{[]int{1, 2}, []int{3, 4}}, [][]int{[]int{5, 6}, []int{7, 8}})
	want := [][]int{[]int{6, 8}, []int{10, 12}}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("addMatrices(M=2, N=2, A=[[1,2],[3,4]], B=[[5,6],[7,8]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestAddMatricesCase2(t *testing.T) {
	got := addMatrices(2, 3, [][]int{[]int{1, 2, 3}, []int{4, 5, 6}}, [][]int{[]int{10, 20, 30}, []int{40, 50, 60}})
	want := [][]int{[]int{11, 22, 33}, []int{44, 55, 66}}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("addMatrices(M=2, N=3, A=[[1,2,3],[4,5,6]], B=[[10,20,30],[40,50,60]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestAddMatricesCase3(t *testing.T) {
	got := addMatrices(3, 2, [][]int{[]int{1, 1}, []int{2, 2}, []int{3, 3}}, [][]int{[]int{9, 9}, []int{8, 8}, []int{7, 7}})
	want := [][]int{[]int{10, 10}, []int{10, 10}, []int{10, 10}}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("addMatrices(M=3, N=2, A=[[1,1],[2,2],[3,3]], B=[[9,9],[8,8],[7,7]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
