package main

import "fmt"

func multiplyMatrices(M int, N int, K int, A [][]int, B [][]int) [][]int {
	result := make([][]int, M)
	for i := 0; i < M; i++ {
		row := make([]int, K)
		for j := 0; j < K; j++ {
			sum := 0
			for k := 0; k < N; k++ {
				sum += A[i][k] * B[k][j]
			}
			row[j] = sum
		}
		result[i] = row
	}
	return result
}

func main() {
	fmt.Println(multiplyMatrices(2, 2, 2, [][]int{[]int{1, 2}, []int{3, 4}}, [][]int{[]int{5, 6}, []int{7, 8}}))
}
