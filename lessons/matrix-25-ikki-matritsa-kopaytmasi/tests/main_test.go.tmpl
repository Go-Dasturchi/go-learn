package main

import (
	"reflect"
	"testing"
)

func TestMultiplyMatricesCase1(t *testing.T) {
	got := multiplyMatrices(2, 2, 2, [][]int{[]int{1, 2}, []int{3, 4}}, [][]int{[]int{5, 6}, []int{7, 8}})
	want := [][]int{[]int{19, 22}, []int{43, 50}}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("multiplyMatrices(M=2, N=2, K=2, A=[[1,2],[3,4]], B=[[5,6],[7,8]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestMultiplyMatricesCase2(t *testing.T) {
	got := multiplyMatrices(2, 3, 2, [][]int{[]int{1, 2, 3}, []int{4, 5, 6}}, [][]int{[]int{1, 2}, []int{3, 4}, []int{5, 6}})
	want := [][]int{[]int{22, 28}, []int{49, 64}}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("multiplyMatrices(M=2, N=3, K=2, A=[[1,2,3],[4,5,6]], B=[[1,2],[3,4],[5,6]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestMultiplyMatricesCase3(t *testing.T) {
	got := multiplyMatrices(3, 2, 3, [][]int{[]int{1, 2}, []int{3, 4}, []int{5, 6}}, [][]int{[]int{1, 2, 3}, []int{4, 5, 6}})
	want := [][]int{[]int{9, 12, 15}, []int{19, 26, 33}, []int{29, 40, 51}}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("multiplyMatrices(M=3, N=2, K=3, A=[[1,2],[3,4],[5,6]], B=[[1,2,3],[4,5,6]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
