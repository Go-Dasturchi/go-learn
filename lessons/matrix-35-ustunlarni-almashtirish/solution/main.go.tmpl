package main

import "fmt"

func swapColumns(M int, N int, K1 int, K2 int, matrix [][]int) [][]int {
	for i := 0; i < M; i++ {
		matrix[i][K1], matrix[i][K2] = matrix[i][K2], matrix[i][K1]
	}
	return matrix
}

func main() {
	fmt.Println(swapColumns(3, 3, 0, 2, [][]int{[]int{1, 2, 3}, []int{4, 5, 6}, []int{7, 8, 9}}))
}
