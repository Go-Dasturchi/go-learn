package main

import (
	"reflect"
	"testing"
)

func TestSwapColumnsCase1(t *testing.T) {
	got := swapColumns(3, 3, 0, 2, [][]int{[]int{1, 2, 3}, []int{4, 5, 6}, []int{7, 8, 9}})
	want := [][]int{[]int{3, 2, 1}, []int{6, 5, 4}, []int{9, 8, 7}}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("swapColumns(M=3, N=3, K1=0, K2=2, matrix=[[1,2,3],[4,5,6],[7,8,9]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSwapColumnsCase2(t *testing.T) {
	got := swapColumns(2, 4, 1, 3, [][]int{[]int{1, 2, 3, 4}, []int{5, 6, 7, 8}})
	want := [][]int{[]int{1, 4, 3, 2}, []int{5, 8, 7, 6}}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("swapColumns(M=2, N=4, K1=1, K2=3, matrix=[[1,2,3,4],[5,6,7,8]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSwapColumnsCase3(t *testing.T) {
	got := swapColumns(4, 2, 0, 1, [][]int{[]int{10, 20}, []int{30, 40}, []int{50, 60}, []int{70, 80}})
	want := [][]int{[]int{20, 10}, []int{40, 30}, []int{60, 50}, []int{80, 70}}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("swapColumns(M=4, N=2, K1=0, K2=1, matrix=[[10,20],[30,40],[50,60],[70,80]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
