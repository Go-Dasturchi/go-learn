package main

import (
	"testing"
)

func TestIsSymmetricCase1(t *testing.T) {
	got := isSymmetric(3, [][]int{[]int{1, 2, 3}, []int{2, 4, 5}, []int{3, 5, 6}})
	want := true
	if got != want {
		t.Errorf("isSymmetric(N=3, matrix=[[1,2,3],[2,4,5],[3,5,6]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestIsSymmetricCase2(t *testing.T) {
	got := isSymmetric(3, [][]int{[]int{1, 2, 3}, []int{4, 5, 6}, []int{7, 8, 9}})
	want := false
	if got != want {
		t.Errorf("isSymmetric(N=3, matrix=[[1,2,3],[4,5,6],[7,8,9]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestIsSymmetricCase3(t *testing.T) {
	got := isSymmetric(2, [][]int{[]int{5, 10}, []int{10, 20}})
	want := true
	if got != want {
		t.Errorf("isSymmetric(N=2, matrix=[[5,10],[10,20]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
