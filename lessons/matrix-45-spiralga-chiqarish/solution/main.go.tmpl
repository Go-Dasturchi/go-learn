package main

import (
	"fmt"
	"strconv"
	"strings"
)

func spiralOrder(M int, N int, matrix [][]int) string {
	result := make([]string, 0, M*N)
	top, bottom, left, right := 0, M-1, 0, N-1
	for top <= bottom && left <= right {
		for j := left; j <= right; j++ {
			result = append(result, strconv.Itoa(matrix[top][j]))
		}
		top++
		for i := top; i <= bottom; i++ {
			result = append(result, strconv.Itoa(matrix[i][right]))
		}
		right--
		if top <= bottom {
			for j := right; j >= left; j-- {
				result = append(result, strconv.Itoa(matrix[bottom][j]))
			}
			bottom--
		}
		if left <= right {
			for i := bottom; i >= top; i-- {
				result = append(result, strconv.Itoa(matrix[i][left]))
			}
			left++
		}
	}
	return strings.Join(result, ",")
}

func main() {
	fmt.Println(spiralOrder(3, 3, [][]int{[]int{1, 2, 3}, []int{4, 5, 6}, []int{7, 8, 9}}))
}
