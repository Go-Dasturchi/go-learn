package main

import "fmt"

func diagonalPartSums(N int, matrix [][]int) int {
	sum := 0
	for i := 0; i < N; i++ {
		sum += matrix[i][i]
		sum += matrix[i][N-1-i]
	}
	if N%2 == 1 {
		mid := N / 2
		sum -= matrix[mid][mid]
	}
	return sum
}

func main() {
	fmt.Println(diagonalPartSums(3, [][]int{[]int{1, 2, 3}, []int{4, 5, 6}, []int{7, 8, 9}}))
}
