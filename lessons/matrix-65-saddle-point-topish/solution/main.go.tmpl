package main

import "fmt"

// findSaddlePoint qatorida eng kichik, ustunida eng katta bo'lgan elementni topadi.
func findSaddlePoint(matrix [][]int) string {
	rows := len(matrix)
	cols := len(matrix[0])
	for i := 0; i < rows; i++ {
		minCol := 0
		for j := 1; j < cols; j++ {
			if matrix[i][j] < matrix[i][minCol] {
				minCol = j
			}
		}
		isColMax := true
		for k := 0; k < rows; k++ {
			if matrix[k][minCol] > matrix[i][minCol] {
				isColMax = false
				break
			}
		}
		if isColMax {
			return fmt.Sprintf("value=%d, pos=(%d,%d)", matrix[i][minCol], i, minCol)
		}
	}
	return ""
}

func main() {
	fmt.Println(findSaddlePoint([][]int{{1, 2, 3}, {4, 5, 6}, {7, 8, 9}}))
}
