package main

import (
	"testing"
)

func TestDeterminantCase1(t *testing.T) {
	got := determinant(2, [][]int{[]int{1, 2}, []int{3, 4}})
	var want int = -2
	if got != want {
		t.Errorf("determinant(N=2, matrix=[[1,2],[3,4]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestDeterminantCase2(t *testing.T) {
	got := determinant(3, [][]int{[]int{1, 2, 3}, []int{4, 5, 6}, []int{7, 8, 9}})
	var want int = 0
	if got != want {
		t.Errorf("determinant(N=3, matrix=[[1,2,3],[4,5,6],[7,8,9]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestDeterminantCase3(t *testing.T) {
	got := determinant(3, [][]int{[]int{2, 5, 3}, []int{1, 2, 1}, []int{3, 1, 4}})
	var want int = -6
	if got != want {
		t.Errorf("determinant(N=3, matrix=[[2,5,3],[1,2,1],[3,1,4]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
