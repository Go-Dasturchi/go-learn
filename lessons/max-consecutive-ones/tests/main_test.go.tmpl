package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{1, 1, 0, 1, 1, 1})
	var want int = 3
	if got != want {
		t.Errorf("solve(nums = [1,1,0,1,1,1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{1, 0, 1, 1, 0, 1})
	var want int = 2
	if got != want {
		t.Errorf("solve(nums = [1,0,1,1,0,1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
