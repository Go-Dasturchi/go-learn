package main

import "fmt"

func gcdMPL(a, b int) int {
	if a < 0 {
		a = -a
	}
	if b < 0 {
		b = -b
	}
	for b != 0 {
		a, b = b, a%b
	}
	return a
}

func solve(points [][]int) int {
	n := len(points)
	if n <= 2 {
		return n
	}
	best := 1
	for i := 0; i < n; i++ {
		slopes := make(map[[2]int]int)
		duplicates := 0
		localMax := 0
		for j := i + 1; j < n; j++ {
			dx := points[j][0] - points[i][0]
			dy := points[j][1] - points[i][1]
			if dx == 0 && dy == 0 {
				duplicates++
				continue
			}
			g := gcdMPL(dx, dy)
			if g != 0 {
				dx /= g
				dy /= g
			}
			if dx < 0 || (dx == 0 && dy < 0) {
				dx, dy = -dx, -dy
			}
			key := [2]int{dx, dy}
			slopes[key]++
			if slopes[key] > localMax {
				localMax = slopes[key]
			}
		}
		total := localMax + duplicates + 1
		if total > best {
			best = total
		}
	}
	return best
}

func main() {
	fmt.Println(solve([][]int{[]int{1, 1}, []int{2, 2}, []int{3, 3}}))
}
