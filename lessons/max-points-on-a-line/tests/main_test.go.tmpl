package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([][]int{[]int{1, 1}, []int{2, 2}, []int{3, 3}})
	var want int = 3
	if got != want {
		t.Errorf("solve(points = [[1,1],[2,2],[3,3]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([][]int{[]int{1, 1}, []int{3, 2}, []int{5, 3}, []int{4, 1}, []int{2, 3}, []int{1, 4}})
	var want int = 4
	if got != want {
		t.Errorf("solve(points = [[1,1],[3,2],[5,3],[4,1],[2,3],[1,4]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
	got := solve([][]int{[]int{0, 0}})
	var want int = 1
	if got != want {
		t.Errorf("solve(points = [[0,0]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
