package main

import (
	"fmt"
	"math"
	"sort"
)

func solve(matrix [][]int, k int) int {
	if len(matrix) == 0 || len(matrix[0]) == 0 {
		return 0
	}
	rows := len(matrix)
	cols := len(matrix[0])
	best := math.MinInt64

	for top := 0; top < rows; top++ {
		colSums := make([]int, cols)
		for bottom := top; bottom < rows; bottom++ {
			for c := 0; c < cols; c++ {
				colSums[c] += matrix[bottom][c]
			}

			// Find max subarray sum <= k using sorted prefix sums.
			prefixSums := []int{0}
			cur := 0
			for _, v := range colSums {
				cur += v
				// binary search for smallest prefix >= cur - k
				idx := sort.SearchInts(prefixSums, cur-k)
				if idx < len(prefixSums) {
					candidate := cur - prefixSums[idx]
					if candidate > best {
						best = candidate
					}
				}
				// insert cur into sorted prefixSums
				pos := sort.SearchInts(prefixSums, cur)
				prefixSums = append(prefixSums, 0)
				copy(prefixSums[pos+1:], prefixSums[pos:])
				prefixSums[pos] = cur
			}
		}
	}

	return best
}

func main() {
	fmt.Println(solve([][]int{{1, 0, 1}, {0, -2, 3}}, 2))
}
