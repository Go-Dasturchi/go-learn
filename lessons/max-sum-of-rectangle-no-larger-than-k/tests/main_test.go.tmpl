package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([][]int{[]int{1, 0, 1}, []int{0, -2, 3}}, 2)
	var want int = 2
	if got != want {
		t.Errorf("solve(matrix = [[1,0,1],[0,-2,3]], k = 2):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([][]int{[]int{2, 2, -1}}, 3)
	var want int = 3
	if got != want {
		t.Errorf("solve(matrix = [[2,2,-1]], k = 3):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
	got := solve([][]int{[]int{2, 2, -1}}, 0)
	var want int = -1
	if got != want {
		t.Errorf("solve(matrix = [[2,2,-1]], k = 0):\nExpected:\n%v\n\nGot:\n%v", want, got)
