package main

import (
	"fmt"
	"strings"
)

func solve(sentences []string) int {
	best := 0
	for _, s := range sentences {
		words := strings.Fields(s)
		if len(words) > best {
			best = len(words)
		}
	}
	return best
}

func main() {
	fmt.Println(solve([]string{"alice and bob love leetcode", "i think so too", "this is great thanks very much"}))
}
