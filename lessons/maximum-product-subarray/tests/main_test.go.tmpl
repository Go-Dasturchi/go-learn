package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{2, 3, -2, 4})
	var want int = 6
	if got != want {
		t.Errorf("solve(nums = [2,3,-2,4]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{-2, 0, -1})
	var want int = 0
	if got != want {
		t.Errorf("solve(nums = [-2,0,-1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
	got := solve([]int{-2, 3, -4})
	var want int = 24
	if got != want {
		t.Errorf("solve(nums = [-2,3,-4]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
