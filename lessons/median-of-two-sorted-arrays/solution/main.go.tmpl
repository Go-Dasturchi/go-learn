package main

import "fmt"

func solve(nums1 []int, nums2 []int) float64 {
	if len(nums1) > len(nums2) {
		nums1, nums2 = nums2, nums1
	}
	m, n := len(nums1), len(nums2)
	total := m + n
	half := (total + 1) / 2

	lo, hi := 0, m
	for lo <= hi {
		i := (lo + hi) / 2
		j := half - i

		leftA := -1 << 62
		if i > 0 {
			leftA = nums1[i-1]
		}
		rightA := 1 << 62
		if i < m {
			rightA = nums1[i]
		}
		leftB := -1 << 62
		if j > 0 {
			leftB = nums2[j-1]
		}
		rightB := 1 << 62
		if j < n {
			rightB = nums2[j]
		}

		if leftA <= rightB && leftB <= rightA {
			maxLeft := leftA
			if leftB > maxLeft {
				maxLeft = leftB
			}
			if total%2 == 1 {
				return float64(maxLeft)
			}
			minRight := rightA
			if rightB < minRight {
				minRight = rightB
			}
			return float64(maxLeft+minRight) / 2.0
		} else if leftA > rightB {
			hi = i - 1
		} else {
			lo = i + 1
		}
	}
	return 0
}

func main() {
	fmt.Println(solve([]int{1, 3}, []int{2}))
}
