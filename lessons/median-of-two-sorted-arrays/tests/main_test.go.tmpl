package main

import (
	"math"
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{1, 3}, []int{2})
	var want float64 = 2.0
	if math.Abs(got-want) > 1e-6 {
		t.Errorf("solve(nums1 = [1,3], nums2 = [2]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
