package main

import (
	"fmt"
	"sort"
)

func solve(intervals [][]int) [][]int {
	if len(intervals) == 0 {
		return [][]int{}
	}
	sorted := make([][]int, len(intervals))
	copy(sorted, intervals)
	sort.Slice(sorted, func(i, j int) bool { return sorted[i][0] < sorted[j][0] })
	res := [][]int{{sorted[0][0], sorted[0][1]}}
	for _, iv := range sorted[1:] {
		last := res[len(res)-1]
		if iv[0] <= last[1] {
			if iv[1] > last[1] {
				last[1] = iv[1]
			}
		} else {
			res = append(res, []int{iv[0], iv[1]})
		}
	}
	return res
}

func main() {
	fmt.Println(solve([][]int{[]int{1, 3}, []int{2, 6}, []int{8, 10}, []int{15, 18}}))
}
