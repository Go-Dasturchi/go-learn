package main

import (
	"reflect"
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([][]int{[]int{1, 4, 5}, []int{1, 3, 4}, []int{2, 6}})
	var want []int = []int{1, 1, 2, 3, 4, 4, 5, 6}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(lists = [[1,4,5],[1,3,4],[2,6]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([][]int{})
	var want []int = []int{}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(lists = []):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
	got := solve([][]int{[]int{}})
	var want []int = []int{}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(lists = [[]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
