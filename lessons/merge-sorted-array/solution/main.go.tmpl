package main

import "fmt"

func solve(nums1 []int, m int, nums2 []int, n int) []int {
	result := make([]int, 0, m+n)
	i, j := 0, 0
	for i < m && j < n {
		if nums1[i] <= nums2[j] {
			result = append(result, nums1[i])
			i++
		} else {
			result = append(result, nums2[j])
			j++
		}
	}
	result = append(result, nums1[i:m]...)
	result = append(result, nums2[j:n]...)
	return result
}

func main() {
	fmt.Println(solve([]int{1, 2, 3, 0, 0, 0}, 3, []int{2, 5, 6}, 3))
}
