package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{1, 3, 6, 9, 12})
	var want int = 2
	if got != want {
		t.Errorf("solve(nums = [1,3,6,9,12]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{4, 7})
	var want int = 3
	if got != want {
		t.Errorf("solve(nums = [4,7]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
