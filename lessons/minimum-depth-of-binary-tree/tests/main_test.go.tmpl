package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{1, 3, -1, -1, -1}, []int{2, 4, -1, -1, -1})
	var want int = 3
	if got != want {
		t.Errorf("solve(leftChildren = [1,3,-1,-1,-1], rightChildren = [2,4,-1,-1,-1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{-1}, []int{-1})
	var want int = 1
	if got != want {
		t.Errorf("solve(leftChildren = [-1], rightChildren = [-1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
