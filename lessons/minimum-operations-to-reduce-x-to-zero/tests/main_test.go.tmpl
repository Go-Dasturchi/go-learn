package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{1, 1, 4, 2, 3}, 5)
	var want int = 2
	if got != want {
		t.Errorf("solve(nums = [1,1,4,2,3], x = 5):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{5, 6, 7, 8, 9}, 4)
	var want int = -1
	if got != want {
		t.Errorf("solve(nums = [5,6,7,8,9], x = 4):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
	got := solve([]int{3, 2, 20, 1, 1, 3}, 10)
	var want int = 5
	if got != want {
		t.Errorf("solve(nums = [3,2,20,1,1,3], x = 10):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
