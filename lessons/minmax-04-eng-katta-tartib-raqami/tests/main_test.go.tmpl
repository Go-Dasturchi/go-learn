package main

import (
	"testing"
)

func TestMaxIndexCase1(t *testing.T) {
	got := maxIndex(5, []int{3, 7, 2, 9, 1})
	want := 4
	if got != want {
		t.Errorf("maxIndex(N=5, nums=[3, 7, 2, 9, 1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestMaxIndexCase2(t *testing.T) {
	got := maxIndex(4, []int{10, 5, 15, 8})
	want := 3
	if got != want {
		t.Errorf("maxIndex(N=4, nums=[10, 5, 15, 8]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestMaxIndexCase3(t *testing.T) {
	got := maxIndex(3, []int{4, 4, 4})
	want := 1
	if got != want {
		t.Errorf("maxIndex(N=3, nums=[4, 4, 4]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
