package main

import "fmt"

func elementsBetweenMinMax(N int, nums []int) int {
	min := nums[0]
	max := nums[0]
	for i := 1; i < N; i++ {
		if nums[i] < min {
			min = nums[i]
		}
		if nums[i] > max {
			max = nums[i]
		}
	}
	count := 0
	for i := 0; i < N; i++ {
		if nums[i] > min && nums[i] < max {
			count++
		}
	}
	return count
}

func main() {
	fmt.Println(elementsBetweenMinMax(5, []int{3, 7, 2, 9, 1}))
}
