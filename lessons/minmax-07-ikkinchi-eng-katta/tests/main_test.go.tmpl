package main

import (
	"testing"
)

func TestSecondMaxCase1(t *testing.T) {
	got := secondMax(5, []int{3, 7, 2, 9, 1})
	want := 7
	if got != want {
		t.Errorf("secondMax(N=5, nums=[3, 7, 2, 9, 1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
