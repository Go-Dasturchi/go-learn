package main

import (
	"testing"
)

func TestMinMaxEvenCase1(t *testing.T) {
	got := minMaxEven(6, []int{3, 8, 2, 9, 4, 10})
	want := "min=2, max=10"
	if got != want {
		t.Errorf("minMaxEven(N=6, nums=[3, 8, 2, 9, 4, 10]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
