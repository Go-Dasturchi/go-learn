package main

import (
	"testing"
)

func TestMinMaxOddCase1(t *testing.T) {
	got := minMaxOdd(6, []int{3, 8, 2, 9, 4, 11})
	want := "min=3, max=11"
	if got != want {
		t.Errorf("minMaxOdd(N=6, nums=[3, 8, 2, 9, 4, 11]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
