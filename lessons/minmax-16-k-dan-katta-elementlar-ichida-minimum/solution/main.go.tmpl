package main

import "fmt"

func minGreaterThanK(N int, K int, nums []int) int {
	result := 0
	found := false
	for i := 0; i < N; i++ {
		if nums[i] > K {
			if !found || nums[i] < result {
				result = nums[i]
				found = true
			}
		}
	}
	if !found {
		return 0
	}
	return result
}

func main() {
	fmt.Println(minGreaterThanK(6, 10, []int{3, 15, 7, 20, 5, 12}))
}
