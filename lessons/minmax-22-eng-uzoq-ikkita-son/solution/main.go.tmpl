package main

import "fmt"

func farthestPair(N int, nums []int) string {
	min := nums[0]
	max := nums[0]
	for i := 1; i < N; i++ {
		if nums[i] < min {
			min = nums[i]
		}
		if nums[i] > max {
			max = nums[i]
		}
	}
	return fmt.Sprintf("%d, %d", min, max)
}

func main() {
	fmt.Println(farthestPair(5, []int{3, 7, 2, 9, 1}))
}
