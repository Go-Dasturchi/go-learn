package main

import (
	"testing"
)

func TestFarthestPairCase1(t *testing.T) {
	got := farthestPair(5, []int{3, 7, 2, 9, 1})
	want := "1, 9"
	if got != want {
		t.Errorf("farthestPair(N=5, nums=[3, 7, 2, 9, 1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
