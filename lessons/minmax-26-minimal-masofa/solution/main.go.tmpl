package main

import (
	"fmt"
	"sort"
)

func minDistance(N int, nums []int) int {
	a := make([]int, N)
	copy(a, nums)
	sort.Ints(a)
	minDiff := a[1] - a[0]
	for i := 1; i < N-1; i++ {
		d := a[i+1] - a[i]
		if d < minDiff {
			minDiff = d
		}
	}
	return minDiff
}

func main() {
	fmt.Println(minDistance(5, []int{10, 5, 8, 12, 3}))
}
