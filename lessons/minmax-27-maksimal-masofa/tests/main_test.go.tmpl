package main

import (
	"testing"
)

func TestMaxDistanceCase1(t *testing.T) {
	got := maxDistance(5, []int{10, 5, 20, 12, 3})
	want := 15
	if got != want {
		t.Errorf("maxDistance(N=5, nums=[10, 5, 20, 12, 3]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
