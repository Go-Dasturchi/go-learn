package main

import (
	"reflect"
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{0, 1, 0, 3, 12})
	var want []int = []int{1, 3, 12, 0, 0}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(nums = [0,1,0,3,12]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
