package main

import "fmt"

func solve(num1 string, num2 string) string {
	if num1 == "0" || num2 == "0" {
		return "0"
	}
	m, n := len(num1), len(num2)
	result := make([]int, m+n)
	for i := m - 1; i >= 0; i-- {
		d1 := int(num1[i] - '0')
		for j := n - 1; j >= 0; j-- {
			d2 := int(num2[j] - '0')
			sum := result[i+j+1] + d1*d2
			result[i+j+1] = sum % 10
			result[i+j] += sum / 10
		}
	}
	res := ""
	started := false
	for _, d := range result {
		if !started {
			if d == 0 {
				continue
			}
			started = true
		}
		res += string(rune('0' + d))
	}
	if !started {
		return "0"
	}
	return res
}

func main() {
	fmt.Println(solve("2", "3"))
}
