package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve("2", "3")
	var want string = "6"
	if got != want {
		t.Errorf("solve(num1 = \"2\", num2 = \"3\"):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve("123", "456")
