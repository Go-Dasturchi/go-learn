package main

import "fmt"

func solve(n int) int {
	cols := make([]bool, n)
	diag1 := make([]bool, 2*n)
	diag2 := make([]bool, 2*n)
	count := 0

	var backtrack func(row int)
	backtrack = func(row int) {
		if row == n {
			count++
			return
		}
		for col := 0; col < n; col++ {
			d1 := row + col
			d2 := row - col + n
			if cols[col] || diag1[d1] || diag2[d2] {
				continue
			}
			cols[col] = true
			diag1[d1] = true
			diag2[d2] = true
			backtrack(row + 1)
			cols[col] = false
			diag1[d1] = false
			diag2[d2] = false
		}
	}

	backtrack(0)
	return count
}

func main() {
	fmt.Println(solve(4))
}
