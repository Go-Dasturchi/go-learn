package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve(4)
	var want int = 2
	if got != want {
		t.Errorf("solve(n = 4):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
