package main

import (
	"reflect"
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve(4)
	var want [][]string = [][]string{[]string{".Q..", "...Q", "Q...", "..Q."}, []string{"..Q.", "Q...", "...Q", ".Q.."}}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(n = 4):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve(1)
	var want [][]string = [][]string{[]string{"Q"}}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(n = 1):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
	got := solve(2)
	var want [][]string = [][]string{}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(n = 2):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
