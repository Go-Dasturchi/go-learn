package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{1, 2, 3, 1, 1, 3})
	var want int = 4
	if got != want {
		t.Errorf("solve(nums = [1,2,3,1,1,3]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{1, 1, 1, 1})
	var want int = 6
	if got != want {
		t.Errorf("solve(nums = [1,1,1,1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
