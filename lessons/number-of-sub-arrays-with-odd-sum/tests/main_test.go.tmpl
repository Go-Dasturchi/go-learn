package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{1, 3, 5})
	var want int = 4
	if got != want {
		t.Errorf("solve(arr = [1,3,5]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{2, 4, 6})
	var want int = 0
	if got != want {
		t.Errorf("solve(arr = [2,4,6]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
	got := solve([]int{1, 2, 3, 4, 5, 6, 7})
	var want int = 16
	if got != want {
		t.Errorf("solve(arr = [1,2,3,4,5,6,7]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
