package main

import "fmt"

func solve(s string) int {
	n := len(s)
	if n == 0 {
		return 0
	}
	isPalindrome := make([][]bool, n)
	for i := range isPalindrome {
		isPalindrome[i] = make([]bool, n)
	}
	for i := 0; i < n; i++ {
		isPalindrome[i][i] = true
	}
	for length := 2; length <= n; length++ {
		for i := 0; i+length-1 < n; i++ {
			j := i + length - 1
			if s[i] == s[j] {
				if length == 2 || isPalindrome[i+1][j-1] {
					isPalindrome[i][j] = true
				}
			}
		}
	}

	cuts := make([]int, n)
	for i := 0; i < n; i++ {
		if isPalindrome[0][i] {
			cuts[i] = 0
			continue
		}
		cuts[i] = i
		for j := 1; j <= i; j++ {
			if isPalindrome[j][i] && cuts[j-1]+1 < cuts[i] {
				cuts[i] = cuts[j-1] + 1
			}
		}
	}

	return cuts[n-1]
}

func main() {
	fmt.Println(solve("aab"))
}
