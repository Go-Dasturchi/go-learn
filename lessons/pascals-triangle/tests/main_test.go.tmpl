package main

import (
	"reflect"
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve(5)
	var want [][]int = [][]int{[]int{1}, []int{1, 1}, []int{1, 2, 1}, []int{1, 3, 3, 1}, []int{1, 4, 6, 4, 1}}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(numRows = 5):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve(1)
	var want [][]int = [][]int{[]int{1}}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(numRows = 1):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
