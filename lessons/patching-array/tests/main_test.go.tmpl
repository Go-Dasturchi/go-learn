package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{1, 3}, 6)
	var want int = 1
	if got != want {
		t.Errorf("solve(nums = [1,3], n = 6):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{1, 5, 10}, 20)
	var want int = 2
	if got != want {
		t.Errorf("solve(nums = [1,5,10], n = 20):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
	got := solve([]int{1, 2, 2}, 5)
	var want int = 0
	if got != want {
		t.Errorf("solve(nums = [1,2,2], n = 5):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
