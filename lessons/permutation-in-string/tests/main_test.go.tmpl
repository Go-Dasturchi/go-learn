package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve("ab", "eidbaooo")
	var want bool = true
	if got != want {
		t.Errorf("solve(s1 = \"ab\", s2 = \"eidbaooo\"):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve("ab", "eidboaoo")
	var want bool = false
	if got != want {
		t.Errorf("solve(s1 = \"ab\", s2 = \"eidboaoo\"):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
