package main

import "fmt"

func solve(nums []int) [][]int {
	res := [][]int{}
	used := make([]bool, len(nums))
	cur := []int{}
	var backtrack func()
	backtrack = func() {
		if len(cur) == len(nums) {
			tmp := make([]int, len(cur))
			copy(tmp, cur)
			res = append(res, tmp)
			return
		}
		for i, n := range nums {
			if used[i] {
				continue
			}
			used[i] = true
			cur = append(cur, n)
			backtrack()
			cur = cur[:len(cur)-1]
			used[i] = false
		}
	}
	backtrack()
	return res
}

func main() {
	fmt.Println(solve([]int{1, 2, 3}))
}
