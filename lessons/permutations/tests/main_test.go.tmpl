package main

import (
	"reflect"
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{1, 2, 3})
	var want [][]int = [][]int{[]int{1, 2, 3}, []int{1, 3, 2}, []int{2, 1, 3}, []int{2, 3, 1}, []int{3, 1, 2}, []int{3, 2, 1}}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(nums = [1,2,3]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{0, 1})
	var want [][]int = [][]int{[]int{0, 1}, []int{1, 0}}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(nums = [0,1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
	got := solve([]int{1})
	var want [][]int = [][]int{[]int{1}}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(nums = [1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
