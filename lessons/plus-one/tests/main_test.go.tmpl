package main

import (
	"reflect"
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{1, 2, 3})
	var want []int = []int{1, 2, 4}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(digits = [1,2,3]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{4, 3, 2, 1})
	var want []int = []int{4, 3, 2, 2}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(digits = [4,3,2,1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
	got := solve([]int{9})
	var want []int = []int{1, 0}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(digits = [9]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
