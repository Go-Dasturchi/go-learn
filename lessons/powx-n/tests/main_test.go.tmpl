package main

import (
	"math"
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve(2.0, 10)
	var want float64 = 1024.0
	if math.Abs(got-want) > 1e-6 {
		t.Errorf("solve(x = 2.00000, n = 10):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve(2.1, 3)
	var want float64 = 9.261
	if math.Abs(got-want) > 1e-6 {
		t.Errorf("solve(x = 2.10000, n = 3):\nExpected:\n%v\n\nGot:\n%v", want, got)
