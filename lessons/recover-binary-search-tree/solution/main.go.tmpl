package main

import "fmt"

func solve(inorder []int) []int {
	n := len(inorder)
	result := make([]int, n)
	copy(result, inorder)

	first, second := -1, -1
	for i := 0; i < n-1; i++ {
		if result[i] > result[i+1] {
			if first == -1 {
				first = i
			}
			second = i + 1
		}
	}

	if first != -1 && second != -1 {
		result[first], result[second] = result[second], result[first]
	}

	return result
}

func main() {
	fmt.Println(solve([]int{1, 3, 2, 4}))
}
