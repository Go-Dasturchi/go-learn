package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{3, 2, 2, 3}, 3)
	var want int = 2
	if got != want {
		t.Errorf("solve(nums = [3,2,2,3], val = 3):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{0, 1, 2, 2, 3, 0, 4, 2}, 2)
	var want int = 5
	if got != want {
		t.Errorf("solve(nums = [0,1,2,2,3,0,4,2], val = 2):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
	got := solve([]int{1}, 1)
	var want int = 0
	if got != want {
		t.Errorf("solve(nums = [1], val = 1):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
