package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([][]int{[]int{1, 3, 5, 7}, []int{10, 11, 16, 20}, []int{23, 30, 34, 60}}, 3)
	var want bool = true
	if got != want {
		t.Errorf("solve(matrix = [[1,3,5,7],[10,11,16,20],[23,30,34,60]], target = 3):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([][]int{[]int{1, 3, 5, 7}, []int{10, 11, 16, 20}, []int{23, 30, 34, 60}}, 13)
	var want bool = false
	if got != want {
		t.Errorf("solve(matrix = [[1,3,5,7],[10,11,16,20],[23,30,34,60]], target = 13):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
	got := solve([][]int{[]int{1}}, 1)
	var want bool = true
	if got != want {
		t.Errorf("solve(matrix = [[1]], target = 1):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
