package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{1, 3, 5, 6}, 5)
	var want int = 2
	if got != want {
		t.Errorf("solve(nums = [1,3,5,6], target = 5):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
