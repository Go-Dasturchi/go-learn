package main

import (
	"reflect"
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{2, 5, 1, 3, 4, 7}, 3)
	var want []int = []int{2, 3, 5, 4, 1, 7}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(nums = [2,5,1,3,4,7], n = 3):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{1, 2, 3, 4, 4, 3, 2, 1}, 4)
	var want []int = []int{1, 4, 2, 3, 3, 2, 4, 1}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(nums = [1,2,3,4,4,3,2,1], n = 4):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
	got := solve([]int{1, 1, 2, 2}, 2)
	var want []int = []int{1, 2, 1, 2}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(nums = [1,1,2,2], n = 2):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
