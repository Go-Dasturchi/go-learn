package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{2, 2, 1})
	var want int = 1
	if got != want {
		t.Errorf("solve(nums = [2,2,1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{4, 1, 2, 1, 2})
	var want int = 4
	if got != want {
		t.Errorf("solve(nums = [4,1,2,1,2]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
	got := solve([]int{1})
	var want int = 1
	if got != want {
		t.Errorf("solve(nums = [1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
