package main

import "fmt"

func solve(nums []int, k int) []int {
	n := len(nums)
	if n == 0 || k <= 0 {
		return []int{}
	}
	result := make([]int, 0, n-k+1)
	deque := []int{} // stores indices, values decreasing

	for i := 0; i < n; i++ {
		for len(deque) > 0 && nums[deque[len(deque)-1]] <= nums[i] {
			deque = deque[:len(deque)-1]
		}
		deque = append(deque, i)

		if deque[0] <= i-k {
			deque = deque[1:]
		}

		if i >= k-1 {
			result = append(result, nums[deque[0]])
		}
	}

	return result
}

func main() {
	fmt.Println(solve([]int{1, 3, -1, -3, 5, 3, 6, 7}, 3))
}
