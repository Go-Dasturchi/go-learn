package main

import (
	"fmt"
	"sort"
)

func solve(nums []int, k int) []float64 {
	n := len(nums)
	if n == 0 || k <= 0 || k > n {
		return []float64{}
	}
	window := make([]int, k)
	copy(window, nums[:k])
	sort.Ints(window)

	result := make([]float64, 0, n-k+1)

	median := func() float64 {
		if k%2 == 1 {
			return float64(window[k/2])
		}
		return (float64(window[k/2-1]) + float64(window[k/2])) / 2.0
	}

	result = append(result, median())

	for i := k; i < n; i++ {
		// remove nums[i-k]
		remove := nums[i-k]
		idx := sort.SearchInts(window, remove)
		window = append(window[:idx], window[idx+1:]...)

		// insert nums[i]
		insert := nums[i]
		pos := sort.SearchInts(window, insert)
		window = append(window, 0)
		copy(window[pos+1:], window[pos:len(window)-1])
		window[pos] = insert

		result = append(result, median())
	}

	return result
}

func main() {
	fmt.Println(solve([]int{1, 3, -1, -3, 5, 3, 6, 7}, 3))
}
