package main

import (
	"reflect"
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{1, 3, -1, -3, 5, 3, 6, 7}, 3)
	var want []float64 = []float64{1.0, -1.0, -1.0, 3.0, 5.0, 6.0}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(nums = [1,3,-1,-3,5,3,6,7], k = 3):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{1, 2, 3, 4, 2, 3, 1, 4, 2}, 3)
	var want []float64 = []float64{2.0, 3.0, 3.0, 3.0, 2.0, 3.0, 2.0}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(nums = [1,2,3,4,2,3,1,4,2], k = 3):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
