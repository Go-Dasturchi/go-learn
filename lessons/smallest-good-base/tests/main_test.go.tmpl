}
func TestSolveCase3(t *testing.T) {
	got := solve("1000000000000000000")
	var want string = "999999999999999999"
	if got != want {
		t.Errorf("solve(n = \"1000000000000000000\"):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
