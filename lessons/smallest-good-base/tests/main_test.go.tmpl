package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve("13")
	var want string = "3"
	if got != want {
		t.Errorf("solve(n = \"13\"):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve("4681")
	var want string = "8"
