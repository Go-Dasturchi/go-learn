package main

import (
	"fmt"
	"sort"
)

func solve(names []string, heights []int) []string {
	idx := make([]int, len(names))
	for i := range idx {
		idx[i] = i
	}
	sort.Slice(idx, func(a, b int) bool {
		return heights[idx[a]] > heights[idx[b]]
	})
	result := make([]string, len(names))
	for i, id := range idx {
		result[i] = names[id]
	}
	return result
}

func main() {
	fmt.Println(solve([]string{"Mary", "John", "Emma"}, []int{180, 165, 170}))
}
