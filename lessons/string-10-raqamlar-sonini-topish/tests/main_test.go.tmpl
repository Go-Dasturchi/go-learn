package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve("Hello123")
	want := 3
	if got != want {
		t.Errorf("solve(S='Hello123'):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
