package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve("Hello World", "World")
	want := 6
	if got != want {
		t.Errorf("solve(S1='Hello World', S2='World'):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
