package main

import "fmt"

func solve(s1 string, s2 string) bool {
	r1 := []rune(s1)
	r2 := []rune(s2)
	if len(r1) != len(r2) {
		return false
	}
	counts := make(map[rune]int)
	for _, r := range r1 {
		counts[r]++
	}
	for _, r := range r2 {
		counts[r]--
	}
	for _, c := range counts {
		if c != 0 {
			return false
		}
	}
	return true
}

func main() {
	fmt.Println(solve("listen", "silent"))
}
