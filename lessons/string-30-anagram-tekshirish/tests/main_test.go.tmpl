package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve("listen", "silent")
	want := true
	if got != want {
		t.Errorf("solve(S1='listen', S2='silent'):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve("hello", "world")
	want := false
	if got != want {
		t.Errorf("solve(S1='hello', S2='world'):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
