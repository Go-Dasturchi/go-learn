package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve("Hello World")
	want := "Hello\\nWorld"
	if got != want {
		t.Errorf("solve(S='Hello World'):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve("One Two Three")
	want := "One\\nTwo\\nThree"
	if got != want {
		t.Errorf("solve(S='One Two Three'):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
	got := solve("Single")
	want := "Single"
	if got != want {
		t.Errorf("solve(S='Single'):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
