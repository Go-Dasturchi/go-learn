package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve("IloveLe3tcode!")
	var want bool = true
	if got != want {
		t.Errorf("solve(password = \"IloveLe3tcode!\"):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve("Me+You--IsMyDream")
	var want bool = false
	if got != want {
		t.Errorf("solve(password = \"Me+You--IsMyDream\"):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase3(t *testing.T) {
	got := solve("1aB!")
	var want bool = false
	if got != want {
		t.Errorf("solve(password = \"1aB!\"):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
