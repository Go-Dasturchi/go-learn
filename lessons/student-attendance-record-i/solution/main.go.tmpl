package main

import "fmt"

func solve(s string) bool {
	absences := 0
	consecutiveLate := 0
	for i := 0; i < len(s); i++ {
		switch s[i] {
		case 'A':
			absences++
			consecutiveLate = 0
		case 'L':
			consecutiveLate++
		default:
			consecutiveLate = 0
		}
		if absences >= 2 || consecutiveLate >= 3 {
			return false
		}
	}
	return true
}

func main() {
	fmt.Println(solve("PPALLP"))
}
