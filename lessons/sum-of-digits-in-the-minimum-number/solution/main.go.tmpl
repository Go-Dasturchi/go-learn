package main

import "fmt"

func solve(nums []int) int {
	min := nums[0]
	for _, n := range nums {
		if n < min {
			min = n
		}
	}
	sum := 0
	for min > 0 {
		sum += min % 10
		min /= 10
	}
	if sum%2 == 0 {
		return 1
	}
	return 0
}

func main() {
	fmt.Println(solve([]int{34, 23, 1, 24, 75, 33, 54, 8}))
}
