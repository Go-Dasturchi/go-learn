package main

import "fmt"

func solve(tasks []string, n int) int {
	freq := make(map[string]int)
	for _, t := range tasks {
		freq[t]++
	}
	maxFreq := 0
	for _, c := range freq {
		if c > maxFreq {
			maxFreq = c
		}
	}
	maxCount := 0
	for _, c := range freq {
		if c == maxFreq {
			maxCount++
		}
	}
	res := (maxFreq-1)*(n+1) + maxCount
	if len(tasks) > res {
		return len(tasks)
	}
	return res
}

func main() {
	fmt.Println(solve([]string{"A", "A", "A", "B", "B", "B"}, 2))
}
