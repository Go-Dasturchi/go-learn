package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]string{"A", "A", "A", "B", "B", "B"}, 2)
	var want int = 8
	if got != want {
		t.Errorf("solve(tasks = [\"A\",\"A\",\"A\",\"B\",\"B\",\"B\"], n = 2):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
