package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([][]int{[]int{1, 4, 3, 1, 3, 2}, []int{3, 2, 1, 3, 2, 4}, []int{2, 3, 3, 2, 3, 1}})
	var want int = 4
	if got != want {
		t.Errorf("solve(heightMap = [[1,4,3,1,3,2],[3,2,1,3,2,4],[2,3,3,2,3,1]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([][]int{[]int{3, 3, 3, 3, 3}, []int{3, 2, 2, 2, 3}, []int{3, 2, 1, 2, 3}, []int{3, 2, 2, 2, 3}, []int{3, 3, 3, 3, 3}})
	var want int = 10
	if got != want {
		t.Errorf("solve(heightMap = [[3,3,3,3,3],[3,2,2,2,3],[3,2,1,2,3],[3,2,2,2,3],[3,3,3,3,3]]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
