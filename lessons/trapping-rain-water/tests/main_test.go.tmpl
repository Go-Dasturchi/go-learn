package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{0, 1, 0, 2, 1, 0, 1, 3, 2, 1, 2, 1})
	var want int = 6
	if got != want {
		t.Errorf("solve(height = [0,1,0,2,1,0,1,3,2,1,2,1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{4, 2, 0, 3, 2, 5})
	var want int = 9
	if got != want {
		t.Errorf("solve(height = [4,2,0,3,2,5]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
