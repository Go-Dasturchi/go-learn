package main

import "fmt"

func solve(board [][]string) bool {
	var rows, cols, boxes [9]map[string]bool
	for i := 0; i < 9; i++ {
		rows[i] = map[string]bool{}
		cols[i] = map[string]bool{}
		boxes[i] = map[string]bool{}
	}
	for r := 0; r < 9; r++ {
		for c := 0; c < 9; c++ {
			v := board[r][c]
			if v == "." {
				continue
			}
			b := (r/3)*3 + c/3
			if rows[r][v] || cols[c][v] || boxes[b][v] {
				return false
			}
			rows[r][v] = true
			cols[c][v] = true
			boxes[b][v] = true
		}
	}
	return true
}

func main() {
	fmt.Println(solve([][]string{[]string{"5", "3", ".", ".", "7", ".", ".", ".", "."}, []string{"6", ".", ".", "1", "9", "5", ".", ".", "."}, []string{".", "9", "8", ".", ".", ".", ".", "6", "."}, []string{"8", ".", ".", ".", "6", ".", ".", ".", "3"}, []string{"4", ".", ".", "8", ".", "3", ".", ".", "1"}, []string{"7", ".", ".", ".", "2", ".", ".", ".", "6"}, []string{".", "6", ".", ".", ".", ".", "2", "8", "."}, []string{".", ".", ".", "4", "1", "9", ".", ".", "5"}, []string{".", ".", ".", ".", "8", ".", ".", "7", "9"}}))
}
