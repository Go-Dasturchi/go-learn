package main

import (
	"fmt"
	"sort"
)

func solve(nums []int) []int {
	n := len(nums)
	sorted := make([]int, n)
	copy(sorted, nums)
	sort.Ints(sorted)
	mid := (n + 1) / 2
	smaller := sorted[:mid]
	larger := sorted[mid:]
	res := make([]int, n)
	si := 0
	for i := 0; i < n; i += 2 {
		res[i] = smaller[si]
		si++
	}
	li := len(larger) - 1
	for i := 1; i < n; i += 2 {
		res[i] = larger[li]
		li--
	}
	return res
}

func main() {
	fmt.Println(solve([]int{1, 5, 1, 1, 6, 4}))
}
