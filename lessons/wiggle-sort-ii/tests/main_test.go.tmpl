package main

import (
	"reflect"
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve([]int{1, 5, 1, 1, 6, 4})
	var want []int = []int{1, 6, 1, 5, 1, 4}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(nums = [1,5,1,1,6,4]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
func TestSolveCase2(t *testing.T) {
	got := solve([]int{1, 3, 2, 2, 3, 1})
	var want []int = []int{1, 3, 1, 3, 2, 2}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("solve(nums = [1,3,2,2,3,1]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
