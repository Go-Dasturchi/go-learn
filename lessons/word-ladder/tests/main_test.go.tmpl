package main

import (
	"testing"
)

func TestSolveCase1(t *testing.T) {
	got := solve("hit", "cog", []string{"hot", "dot", "dog", "lot", "log", "cog"})
	var want int = 5
	if got != want {
		t.Errorf("solve(beginWord = \"hit\", endWord = \"cog\", wordList = [\"hot\",\"dot\",\"dog\",\"lot\",\"log\",\"cog\"]):\nExpected:\n%v\n\nGot:\n%v", want, got)
	}
}
