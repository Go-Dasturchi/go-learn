package main

import (
	"fmt"
	"sort"
)

type trieNode struct {
	children [26]*trieNode
	word     string
}

func solve(board [][]string, words []string) []string {
	root := &trieNode{}
	for _, w := range words {
		node := root
		for i := 0; i < len(w); i++ {
			idx := w[i] - 'a'
			if node.children[idx] == nil {
				node.children[idx] = &trieNode{}
			}
			node = node.children[idx]
		}
		node.word = w
	}

	if len(board) == 0 || len(board[0]) == 0 {
		return []string{}
	}
	rows, cols := len(board), len(board[0])
	foundSet := make(map[string]bool)

	var dfs func(r, c int, node *trieNode)
	dfs = func(r, c int, node *trieNode) {
		if r < 0 || r >= rows || c < 0 || c >= cols {
			return
		}
		ch := board[r][c]
		if ch == "#" || len(ch) == 0 {
			return
		}
		idx := ch[0] - 'a'
		next := node.children[idx]
		if next == nil {
			return
		}
		if next.word != "" {
			foundSet[next.word] = true
		}

		board[r][c] = "#"
		dfs(r+1, c, next)
		dfs(r-1, c, next)
		dfs(r, c+1, next)
		dfs(r, c-1, next)
		board[r][c] = ch
	}

	for r := 0; r < rows; r++ {
		for c := 0; c < cols; c++ {
			dfs(r, c, root)
		}
	}

	result := make([]string, 0, len(foundSet))
	for w := range foundSet {
		result = append(result, w)
	}
	sort.Strings(result)

	return result
}

func main() {
	fmt.Println(solve([][]string{{"o", "a", "a", "n"}, {"e", "t", "a", "e"}, {"i", "h", "k", "r"}, {"i", "f", "l", "v"}}, []string{"oath", "pea", "eat", "rain"}))
}
